<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>University & Innovator Portal — SolveLink</title>
  
  <link rel="stylesheet" href="/css/global.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/challenges.css">
  <link rel="stylesheet" href="/css/problem.css">
  <link rel="stylesheet" href="/css/responsive.css">
</head>
<body>

  <!-- Navigation Bar -->
  <%- include('../partials/navbar', { activePath: '/university/dashboard' }) %>

  <!-- Dashboard Layout -->
  <div class="dashboard-layout">
    
    <!-- Dynamic Reusable Sidebar -->
    <%- include('../partials/sidebar', { role: user && user.role ? user.role : 'university', activePath: '/university/dashboard' }) %>

    <!-- Main Dashboard Work Area -->
    <main id="main-content" class="dashboard-main">
      <div class="dashboard-content">
        
        <!-- Topbar -->
        <div class="dashboard-topbar">
          <div class="dashboard-title-group">
            <h1 class="dashboard-welcome"><%= (user && user.role === 'industry') ? 'Industry Partner Portal' : 'Innovator & Research Portal' %></h1>
            <p class="dashboard-sub"><%= user ? (user.organization || user.name) : 'Partner Organization' %> &bull; <%= (user && user.role === 'industry') ? 'Enterprise Scaling & Pilot Opportunities' : 'AI-Powered Challenge Matching' %></p>
          </div>
          <div class="dashboard-actions">
            <a href="/university/challenges" class="btn btn-secondary btn-md">
              Discover All Challenges
            </a>
            <a href="/university/submit-solution" class="btn btn-primary btn-md">
              <%= (user && user.role === 'industry') ? '+ Propose Implementation' : '+ Submit Proposal' %>
            </a>
          </div>
        </div>

        <% if (typeof submittedMsg !== 'undefined' && submittedMsg) { %>
          <div class="alert alert-success" style="margin-bottom: var(--space-6);">
            <span><%= submittedMsg %></span>
          </div>
        <% } %>

        <!-- Metrics Grid -->
        <div class="dash-stats-grid">
          <div class="dash-stat-card" style="border-left: 3px solid var(--color-primary);">
            <div>
              <div class="dash-stat-num" style="color: var(--color-primary);"><%= metrics.topMatchScore %>%</div>
              <div class="dash-stat-label">Top Skill Match</div>
            </div>
            <div class="dash-stat-icon" style="color: var(--color-primary);">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
              </svg>
            </div>
          </div>

          <div class="dash-stat-card">
            <div>
              <div class="dash-stat-num"><%= metrics.submittedCount %></div>
              <div class="dash-stat-label">Total Submissions</div>
            </div>
            <div class="dash-stat-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="22" y1="2" x2="11" y2="13"></line>
                <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
              </svg>
            </div>
          </div>

          <div class="dash-stat-card" style="border-left: 3px solid var(--color-warning);">
            <div>
              <div class="dash-stat-num" style="color: var(--color-warning);"><%= metrics.shortlistedCount %></div>
              <div class="dash-stat-label">Shortlisted</div>
            </div>
            <div class="dash-stat-icon" style="color: var(--color-warning);">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="8" r="7"></circle>
                <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline>
              </svg>
            </div>
          </div>

          <div class="dash-stat-card" style="border-left: 3px solid var(--color-success);">
            <div>
              <div class="dash-stat-num" style="color: var(--color-success);"><%= metrics.selectedCount %></div>
              <div class="dash-stat-label">Funded Pilot Awards</div>
            </div>
            <div class="dash-stat-icon" style="color: var(--color-success);">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
              </svg>
            </div>
          </div>
        </div>

        <!-- Dashboard Main Grid Split -->
        <div class="dash-grid-split">
          
          <!-- Column Left: Recommended Challenges Ranked by AI Skill Match -->
          <div>
            <div class="dash-section-header">
              <h2 class="dash-section-title">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                </svg>
                AI Recommended Challenges for Your Team
              </h2>
              <a href="/university/challenges" class="btn btn-ghost btn-sm">Explore All &rarr;</a>
            </div>

            <% if (recommendedChallenges && recommendedChallenges.length > 0) { %>
              <div class="dash-problem-list">
                <% recommendedChallenges.forEach(function(c) { 
                  let matchBadgeClass = 'badge-neutral';
                  if (c.matchScore >= 75) matchBadgeClass = 'badge-success';
                  else if (c.matchScore >= 50) matchBadgeClass = 'badge-warning';
                %>
                  <a href="/university/challenges/<%= c._id %>" class="dash-problem-card" style="padding: var(--space-4) var(--space-5);">
                    <div class="dash-problem-info">
                      <div style="display: flex; align-items: center; gap: var(--space-2); margin-bottom: 2px;">
                        <span class="badge badge-primary" style="font-size: 0.6875rem;"><%= c.category %></span>
                        <span class="badge <%= matchBadgeClass %>" style="font-size: 0.6875rem;">
                          <%= c.matchScore %>% Team Match
                        </span>
                      </div>
                      <span class="dash-problem-title" style="font-size: var(--font-size-base);"><%= c.title %></span>
                      
                      <div class="dash-problem-meta" style="margin-top: 3px;">
                        <span>📍 <%= c.location || 'Jharkhand' %></span>
                        <span>&bull;</span>
                        <span>Dept: <%= c.department %></span>
                        <% if (c.matchingSkills && c.matchingSkills.length > 0) { %>
                          <span>&bull;</span>
                          <span style="color: var(--color-success);">Matching: <%= c.matchingSkills.join(', ') %></span>
                        <% } %>
                      </div>
                    </div>
                    
                    <div class="dash-problem-side">
                      <span class="btn btn-primary btn-sm">Review Brief &rarr;</span>
                    </div>
                  </a>
                <% }); %>
              </div>
            <% } else { %>
              <div class="card card-body text-center" style="padding: var(--space-8);">
                <p class="text-muted" style="margin-bottom: 0;">No active innovation challenges matching at this time.</p>
              </div>
            <% } %>
          </div>

          <!-- Column Right: Team Skills & My Submissions -->
          <div style="display: flex; flex-direction: column; gap: var(--space-6);">
            
            <!-- Team Profile & Registered Skills Card -->
            <div class="card card-body">
              <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--space-3);">
                <h3 style="font-size: var(--font-size-sm); font-weight: var(--font-weight-bold); text-transform: uppercase; color: var(--color-text-muted); margin-bottom: 0;">
                  Team Competency Profile
                </h3>
                <span class="badge badge-neutral" style="font-size: 0.6875rem;"><%= user.role %></span>
              </div>

              <div style="margin-bottom: var(--space-3);">
                <strong><%= user.name %></strong>
                <div class="text-muted" style="font-size: var(--font-size-xs);"><%= user.organization || 'Institutional Innovator' %></div>
              </div>

              <div style="font-size: var(--font-size-xs); font-weight: var(--font-weight-semibold); color: var(--color-text-muted); margin-bottom: var(--space-2); text-transform: uppercase;">
                Registered Capabilities:
              </div>

              <div style="display: flex; flex-wrap: wrap; gap: var(--space-2); margin-bottom: var(--space-4);">
                <% if (user.skills && user.skills.length > 0) { %>
                  <% user.skills.forEach(function(s) { %>
                    <span class="badge badge-primary" style="font-size: 0.6875rem;"><%= s %></span>
                  <% }); %>
                <% } else { %>
                  <span class="badge badge-neutral">General Engineering</span>
                  <span class="badge badge-neutral">Applied Research</span>
                <% } %>
              </div>

              <p class="text-muted" style="font-size: var(--font-size-xs); margin-bottom: 0;">
                Our AI matching service compares these skills against active government challenges to highlight optimal grant opportunities.
              </p>
            </div>

            <!-- My Submitted Proposals -->
            <div>
              <div class="dash-section-header">
                <h2 class="dash-section-title">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="9 11 12 14 22 4"></polyline>
                    <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
                  </svg>
                  My Proposal Submissions
                </h2>
              </div>

              <% if (mySolutions && mySolutions.length > 0) { %>
                <div class="dash-problem-list">
                  <% mySolutions.forEach(function(s) { 
                    let solBadge = 'badge-neutral';
                    if (s.status === 'SELECTED' || s.status === 'ACCEPTED' || s.status === 'IMPLEMENTATION') solBadge = 'badge-success';
                    else if (s.status === 'SHORTLISTED') solBadge = 'badge-primary';
                    else if (s.status === 'SUBMITTED' || s.status === 'UNDER_REVIEW') solBadge = 'badge-warning';
                    else if (s.status === 'REJECTED') solBadge = 'badge-danger';
                  %>
                    <div class="dash-problem-card">
                      <div class="dash-problem-info">
                        <span class="dash-problem-title"><%= s.title %></span>
                        <div class="dash-problem-meta">
                          <span>Challenge: <%= s.challenge?.title ? s.challenge.title.substring(0, 28) + '...' : 'Innovation Challenge' %></span>
                          <span>&bull;</span>
                          <span>Submitted: <%= new Date(s.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %></span>
                        </div>
                      </div>
                      <span class="badge <%= solBadge %>"><%= s.status.replace('_', ' ') %></span>
                    </div>
                  <% }); %>
                </div>
              <% } else { %>
                <div class="card card-body text-center" style="padding: var(--space-6);">
                  <p class="text-muted" style="font-size: var(--font-size-sm); margin-bottom: var(--space-3);">No proposals submitted yet.</p>
                  <a href="/university/challenges" class="btn btn-primary btn-sm">Find a Challenge to Solve</a>
                </div>
              <% } %>
            </div>

            <!-- Industry Partnership Inquiries on My Solutions -->
            <% if (typeof industryCollaborations !== 'undefined' && industryCollaborations && industryCollaborations.length > 0) { %>
              <div>
                <div class="dash-section-header">
                  <h2 class="dash-section-title">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                      <circle cx="9" cy="7" r="4"></circle>
                      <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                      <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                    </svg>
                    Industry Partnership Offers (<%= industryCollaborations.length %>)
                  </h2>
                </div>

                <div class="dash-problem-list">
                  <% industryCollaborations.forEach(function(collab) { %>
                    <div class="dash-problem-card">
                      <div class="dash-problem-info">
                        <span class="dash-problem-title"><%= collab.industry?.organization || collab.industry?.name %></span>
                        <div class="dash-problem-meta">
                          <span>Proposal: <strong><%= collab.proposal?.title?.substring(0, 25) %>...</strong></span>
                          <span>&bull;</span>
                          <span>Offer: <%= (collab.supportType || 'Pilot').replace('_', ' ') %></span>
                        </div>
                        <% if (collab.message) { %>
                          <p class="text-muted" style="font-size: var(--font-size-xs); margin-top: 4px; margin-bottom: 0;">
                            "<%= collab.message %>"
                          </p>
                        <% } %>
                      </div>
                      <span class="badge badge-success">Partner Offer</span>
                    </div>
                  <% }); %>
                </div>
              </div>
            <% } %>

          </div>

        </div>

      </div>
    </main>

  </div>

  <!-- Footer -->
  <%- include('../partials/footer') %>

  <script src="/js/dashboard.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
