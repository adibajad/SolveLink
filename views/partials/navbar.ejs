<a href="#main-content" class="skip-link">Skip to main content</a>

<nav class="navbar" aria-label="Main Navigation">
  <div class="navbar-container">
    <!-- Brand Logo -->
    <a href="/" class="navbar-brand" aria-label="SolveLink Home">
      <svg class="brand-logo-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <circle cx="5" cy="6" r="3" fill="#7B2340" />
        <circle cx="19" cy="6" r="3" fill="#C28B38" />
        <circle cx="12" cy="18" r="3.5" fill="#7B2340" />
        <line x1="7.5" y1="6" x2="16.5" y2="6" stroke="#7B2340" stroke-width="1.8" stroke-linecap="round" />
        <line x1="6.8" y1="8.5" x2="10.5" y2="15.5" stroke="#7B2340" stroke-width="1.8" stroke-linecap="round" />
        <line x1="17.2" y1="8.5" x2="13.5" y2="15.5" stroke="#C28B38" stroke-width="1.8" stroke-linecap="round" />
      </svg>
      <span class="brand-name">Solve<span class="brand-name-suffix">Link</span></span>
    </a>

    <!-- Desktop Navigation Links (Platform Navigation Only) -->
    <ul class="navbar-nav">
      <li>
        <a href="/" class="nav-link <%= (typeof activePath !== 'undefined' && activePath === '/') ? 'active' : '' %>">
          Home
        </a>
      </li>
      <li>
        <a href="/about" class="nav-link <%= (typeof activePath !== 'undefined' && activePath === '/about') ? 'active' : '' %>">
          About
        </a>
      </li>
      <li>
        <a href="/resources" class="nav-link <%= (typeof activePath !== 'undefined' && activePath === '/resources') ? 'active' : '' %>">
          Resources
        </a>
      </li>
    </ul>

    <!-- Right Side Actions -->
    <div class="navbar-actions">
      <a href="/challenges" class="search-trigger-btn" aria-label="Search Challenges">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <span>Search</span>
      </a>

      <% if (typeof user !== 'undefined' && user) { 
        const isDashActive = typeof activePath !== 'undefined' && (
          activePath === '/dashboard' || 
          activePath.startsWith('/citizen/dashboard') || 
          activePath.startsWith('/citizen/my-problems') || 
          activePath.startsWith('/citizen/report-problem') ||
          activePath.startsWith('/authority') ||
          activePath.startsWith('/university') ||
          activePath.startsWith('/industry') ||
          activePath.startsWith('/admin')
        );
      %>
        <a href="/dashboard" class="btn btn-secondary btn-sm <%= isDashActive ? 'active' : '' %>">
          Dashboard
        </a>
        <a href="/auth/logout" class="btn btn-outline btn-sm btn-logout-trigger" data-logout-trigger="true">
          Logout
        </a>
      <% } else { %>
        <a href="/auth/login" class="btn btn-ghost btn-sm">
          Login
        </a>
        <a href="/auth/register" class="btn btn-primary btn-sm">
          Get Started
        </a>
      <% } %>

      <!-- Mobile Hamburger Toggle -->
      <button id="mobileMenuToggle" class="mobile-menu-toggle" aria-label="Toggle navigation menu" aria-expanded="false">
        <svg class="menu-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <svg class="close-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div id="mobileNavDrawer" class="mobile-nav-drawer">
    <ul class="mobile-nav-list">
      <li>
        <a href="/" class="mobile-nav-link <%= (typeof activePath !== 'undefined' && activePath === '/') ? 'active' : '' %>">
          Home
        </a>
      </li>
      <li>
        <a href="/about" class="mobile-nav-link <%= (typeof activePath !== 'undefined' && activePath === '/about') ? 'active' : '' %>">
          About
        </a>
      </li>
      <li>
        <a href="/resources" class="mobile-nav-link <%= (typeof activePath !== 'undefined' && activePath === '/resources') ? 'active' : '' %>">
          Resources
        </a>
      </li>
    </ul>

    <div class="mobile-nav-actions">
      <% if (typeof user !== 'undefined' && user) { %>
        <a href="/dashboard" class="btn btn-primary btn-block">
          Dashboard
        </a>
        <a href="/auth/logout" class="btn btn-outline btn-block btn-logout-trigger" data-logout-trigger="true">
          Logout
        </a>
      <% } else { %>
        <a href="/auth/login" class="btn btn-secondary btn-block">
          Login
        </a>
        <a href="/auth/register" class="btn btn-primary btn-block">
          Get Started
        </a>
      <% } %>
    </div>
  </div>
</nav>

<% if (typeof user !== 'undefined' && user) { %>
  <!-- Native SolveLink Logout Confirmation Modal Overlay -->
  <div id="logoutConfirmModal" class="ai-processing-modal" role="dialog" aria-modal="true" aria-labelledby="logoutModalTitle" style="display: none; z-index: var(--z-modal);">
    <div class="ai-processing-card" style="max-width: 420px; text-align: left; padding: var(--space-6);">
      
      <div style="display: flex; align-items: center; gap: var(--space-3); margin-bottom: var(--space-3);">
        <div style="width: 40px; height: 40px; border-radius: var(--radius-full); background-color: rgba(123, 35, 64, 0.12); display: flex; align-items: center; justify-content: center; color: var(--color-primary); flex-shrink: 0;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
            <polyline points="16 17 21 12 16 7"></polyline>
            <line x1="21" y1="12" x2="9" y2="12"></line>
          </svg>
        </div>
        <div>
          <h3 id="logoutModalTitle" style="font-size: var(--font-size-lg); font-weight: var(--font-weight-bold); margin-bottom: 0; color: var(--color-text);">
            Are you sure you want to log out?
          </h3>
        </div>
      </div>

      <p style="font-size: var(--font-size-sm); color: var(--color-text-muted); line-height: 1.5; margin-bottom: var(--space-6);">
        Your current session will be ended.
      </p>

      <div style="display: flex; justify-content: flex-end; gap: var(--space-3);">
        <button type="button" id="btnCancelLogout" class="btn btn-outline">Cancel</button>
        <form id="logoutConfirmForm" action="/auth/logout" method="POST" style="margin: 0; display: inline-block;">
          <button type="submit" id="btnConfirmLogout" class="btn btn-primary" style="background-color: var(--color-primary);">
            Logout
          </button>
        </form>
      </div>

    </div>
  </div>
<% } %>
