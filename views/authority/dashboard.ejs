<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Authority Command Center — SolveLink</title>
  
  <link rel="stylesheet" href="/css/global.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/problem.css">
  <link rel="stylesheet" href="/css/responsive.css">
</head>
<body>

  <!-- Navigation Bar -->
  <%- include('../partials/navbar', { activePath: '/authority/dashboard' }) %>

  <!-- Dashboard Container -->
  <div class="dashboard-layout">
    
    <!-- Dynamic Reusable Sidebar -->
    <%- include('../partials/sidebar', { role: 'authority', activePath: '/authority/dashboard' }) %>

    <!-- Main Dashboard Work Area -->
    <main id="main-content" class="dashboard-main">
      <div class="dashboard-content">
        
        <!-- Topbar -->
        <div class="dashboard-topbar">
          <div class="dashboard-title-group">
            <h1 class="dashboard-welcome">Authority Command Center</h1>
            <p class="dashboard-sub"><%= user ? (user.organization || user.name) : 'Authority Officer' %> &bull; Municipal & Regional Problem Triage</p>
          </div>
          <div class="dashboard-actions">
            <a href="/authority/problems" class="btn btn-secondary btn-md">
              Review Incoming Problems (<%= metrics.pendingVerification %>)
            </a>
            <a href="/authority/create-challenge" class="btn btn-primary btn-md">
              + Create Innovation Challenge
            </a>
          </div>
        </div>

        <!-- 5 Command Center Metrics -->
        <div class="dash-stats-grid dash-stats-grid-5">
          <div class="dash-stat-card">
            <div>
              <div class="dash-stat-num"><%= metrics.totalProblems %></div>
              <div class="dash-stat-label">Total Reports</div>
            </div>
            <div class="dash-stat-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
              </svg>
            </div>
          </div>

          <div class="dash-stat-card" style="border-left: 3px solid var(--color-warning);">
            <div>
              <div class="dash-stat-num" style="color: var(--color-warning);"><%= metrics.pendingVerification %></div>
              <div class="dash-stat-label">Pending Triage</div>
            </div>
            <div class="dash-stat-icon" style="color: var(--color-warning);">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
              </svg>
            </div>
          </div>

          <div class="dash-stat-card" style="border-left: 3px solid var(--color-primary);">
            <div>
              <div class="dash-stat-num" style="color: var(--color-primary);"><%= metrics.activeChallenges %></div>
              <div class="dash-stat-label">Active Challenges</div>
            </div>
            <div class="dash-stat-icon" style="color: var(--color-primary);">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="8" r="7"></circle>
                <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline>
              </svg>
            </div>
          </div>

          <div class="dash-stat-card">
            <div>
              <div class="dash-stat-num"><%= metrics.totalSolutions %></div>
              <div class="dash-stat-label">Solutions Received</div>
            </div>
            <div class="dash-stat-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 11 12 14 22 4"></polyline>
                <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
              </svg>
            </div>
          </div>

          <div class="dash-stat-card" style="border-left: 3px solid var(--color-success);">
            <div>
              <div class="dash-stat-num" style="color: var(--color-success);"><%= metrics.implementations %></div>
              <div class="dash-stat-label">Implementations</div>
            </div>
            <div class="dash-stat-icon" style="color: var(--color-success);">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
              </svg>
            </div>
          </div>
        </div>

        <!-- Main Triage & Action Split -->
        <div class="dash-grid-split">
          
          <!-- Column Left: Priority Problems Requiring Action -->
          <div>
            <div class="dash-section-header">
              <h2 class="dash-section-title">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                  <line x1="12" y1="9" x2="12" y2="13"></line>
                  <line x1="12" y1="17" x2="12.01" y2="17"></line>
                </svg>
                Priority Problems for Triage
              </h2>
              <a href="/authority/problems" class="btn btn-ghost btn-sm">View All Problems &rarr;</a>
            </div>

            <% if (priorityProblems && priorityProblems.length > 0) { %>
              <div class="dash-problem-list">
                <% priorityProblems.forEach(function(prob) { %>
                  <a href="/authority/problems/<%= prob._id %>" class="dash-problem-card" style="padding: var(--space-4) var(--space-5);">
                    <div class="dash-problem-info">
                      <div style="display: flex; align-items: center; gap: var(--space-2); margin-bottom: 2px;">
                        <span class="badge badge-primary" style="font-size: 0.6875rem;"><%= prob.category %></span>
                        <% if (prob.priority === 'CRITICAL' || prob.priority === 'HIGH') { %>
                          <span class="badge badge-danger" style="font-size: 0.6875rem;"><%= prob.priority %> Priority</span>
                        <% } %>
                        <span class="badge badge-warning" style="font-size: 0.6875rem;"><%= prob.status.replace('_', ' ') %></span>
                      </div>
                      <span class="dash-problem-title" style="font-size: var(--font-size-base);"><%= prob.title %></span>
                      <div class="dash-problem-meta" style="margin-top: 2px;">
                        <span>📍 <%= prob.location %></span>
                        <span>&bull;</span>
                        <span>👥 <%= prob.supporters ? prob.supporters.length : 1 %> Supporters</span>
                        <span>&bull;</span>
                        <span>Submitted <%= new Date(prob.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %></span>
                      </div>
                    </div>
                    
                    <div class="dash-problem-side">
                      <span class="btn btn-primary btn-sm">Triage &rarr;</span>
                    </div>
                  </a>
                <% }); %>
              </div>
            <% } else { %>
              <div class="card card-body text-center" style="padding: var(--space-8);">
                <p class="text-muted" style="margin-bottom: 0;">No pending high-priority problems in queue. All clear!</p>
              </div>
            <% } %>
          </div>

          <!-- Column Right: Solutions Pending Review & Active Challenges -->
          <div style="display: flex; flex-direction: column; gap: var(--space-6);">
            
            <!-- Solutions Pending Review -->
            <div>
              <div class="dash-section-header">
                <h2 class="dash-section-title">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                  </svg>
                  Proposals Pending Review
                </h2>
                <a href="/authority/solutions" class="btn btn-ghost btn-sm">View All &rarr;</a>
              </div>

              <% if (pendingSolutions && pendingSolutions.length > 0) { %>
                <div class="dash-problem-list">
                  <% pendingSolutions.forEach(function(sol) { %>
                    <a href="/authority/solutions/<%= sol._id %>" class="dash-problem-card">
                      <div class="dash-problem-info">
                        <span class="dash-problem-title"><%= sol.title %></span>
                        <div class="dash-problem-meta">
                          <span>Team: <%= sol.team?.name || sol.submittedBy?.name %></span>
                          <span>&bull;</span>
                          <span><%= sol.challenge?.title?.substring(0, 25) %>...</span>
                        </div>
                      </div>
                      <span class="badge badge-warning">Review</span>
                    </a>
                  <% }); %>
                </div>
              <% } else { %>
                <div class="card card-body text-center" style="padding: var(--space-6);">
                  <p class="text-muted" style="font-size: var(--font-size-sm); margin-bottom: 0;">No proposals pending evaluation.</p>
                </div>
              <% } %>
            </div>

            <!-- Authority's Innovation Challenges -->
            <div>
              <div class="dash-section-header">
                <h2 class="dash-section-title">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="8" r="7"></circle>
                    <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline>
                  </svg>
                  My Published Challenges
                </h2>
              </div>

              <% if (myChallenges && myChallenges.length > 0) { %>
                <div class="dash-problem-list">
                  <% myChallenges.forEach(function(c) { %>
                    <a href="/challenges/<%= c._id %>" class="dash-problem-card">
                      <div class="dash-problem-info">
                        <span class="dash-problem-title"><%= c.title %></span>
                        <div class="dash-problem-meta">
                          <span><%= c.category %></span>
                          <span>&bull;</span>
                          <span><%= c.location || 'Jharkhand' %></span>
                        </div>
                      </div>
                      <span class="badge badge-success"><%= c.status %></span>
                    </a>
                  <% }); %>
                </div>
              <% } else { %>
                <div class="card card-body text-center" style="padding: var(--space-6);">
                  <p class="text-muted" style="font-size: var(--font-size-sm); margin-bottom: var(--space-3);">You haven't created any challenges yet.</p>
                  <a href="/authority/create-challenge" class="btn btn-primary btn-sm">+ Create First Challenge</a>
                </div>
              <% } %>
            </div>

          </div>

        </div>

      </div>
    </main>

  </div>

  <!-- Footer -->
  <%- include('../partials/footer') %>

  <script src="/js/dashboard.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
