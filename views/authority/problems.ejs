<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Problem Triage Queue — SolveLink Authority</title>
  
  <link rel="stylesheet" href="/css/global.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/challenges.css">
  <link rel="stylesheet" href="/css/problem.css">
  <link rel="stylesheet" href="/css/responsive.css">
</head>
<body>

  <!-- Navigation -->
  <%- include('../partials/navbar', { activePath: '/authority/problems' }) %>

  <!-- Dashboard Container -->
  <div class="dashboard-layout">
    
    <!-- Sidebar -->
    <%- include('../partials/sidebar', { role: 'authority', activePath: '/authority/problems' }) %>

    <!-- Main Content -->
    <main id="main-content" class="dashboard-main">
      <div class="dashboard-content">
        
        <!-- Header Topbar -->
        <div class="dashboard-topbar">
          <div>
            <h1 class="dashboard-welcome">Problem Triage & Verification</h1>
            <p class="dashboard-sub">Review citizen reports, inspect AI categorization, verify authenticity, and elevate into innovation challenges.</p>
          </div>
          <div>
            <a href="/authority/create-challenge" class="btn btn-primary btn-md">
              + Create Challenge
            </a>
          </div>
        </div>

        <!-- Filter Bar -->
        <form action="/authority/problems" method="GET" class="filter-bar" style="margin-bottom: var(--space-6);">
          <div class="filter-grid filter-grid-authority">
            
            <!-- Search -->
            <div class="filter-group">
              <label for="filterSearch" class="filter-label">Search Reports</label>
              <input 
                type="text" 
                id="filterSearch" 
                name="q" 
                class="filter-input" 
                placeholder="Title, description, or landmark..." 
                value="<%= typeof query !== 'undefined' && query.q ? query.q : '' %>"
              />
            </div>

            <!-- Assignment Status -->
            <div class="filter-group">
              <label for="filterAssignment" class="filter-label">Assignment Queue</label>
              <select id="filterAssignment" name="assignmentStatus" class="filter-select">
                <option value="">All Assigned to Me</option>
                <option value="assigned" <%= (typeof query !== 'undefined' && query.assignmentStatus === 'assigned') ? 'selected' : '' %>>Directly Assigned</option>
                <option value="needs_review" <%= (typeof query !== 'undefined' && query.assignmentStatus === 'needs_review') ? 'selected' : '' %>>Needs Review / Triage</option>
                <option value="verified" <%= (typeof query !== 'undefined' && query.assignmentStatus === 'verified') ? 'selected' : '' %>>Verified</option>
              </select>
            </div>

            <!-- Status -->
            <div class="filter-group">
              <label for="filterStatus" class="filter-label">Status</label>
              <select id="filterStatus" name="status" class="filter-select">
                <option value="">All Statuses</option>
                <option value="REPORTED" <%= (typeof query !== 'undefined' && query.status === 'REPORTED') ? 'selected' : '' %>>Reported (New)</option>
                <option value="UNDER_VERIFICATION" <%= (typeof query !== 'undefined' && query.status === 'UNDER_VERIFICATION') ? 'selected' : '' %>>Under Verification</option>
                <option value="VERIFIED" <%= (typeof query !== 'undefined' && query.status === 'VERIFIED') ? 'selected' : '' %>>Verified</option>
                <option value="CHALLENGE_CREATED" <%= (typeof query !== 'undefined' && query.status === 'CHALLENGE_CREATED') ? 'selected' : '' %>>Challenge Created</option>
                <option value="ALREADY_RESOLVED" <%= (typeof query !== 'undefined' && query.status === 'ALREADY_RESOLVED') ? 'selected' : '' %>>Resolved</option>
                <option value="REJECTED" <%= (typeof query !== 'undefined' && query.status === 'REJECTED') ? 'selected' : '' %>>Rejected / Invalid</option>
              </select>
            </div>

            <!-- Category / Domain -->
            <div class="filter-group">
              <label for="filterCategory" class="filter-label">Domain / Sector</label>
              <select id="filterCategory" name="domain" class="filter-select">
                <option value="">All Sectors</option>
                <% if (typeof sectors !== 'undefined' && sectors) { %>
                  <% sectors.forEach(function(sec) { %>
                    <option value="<%= sec.key %>" <%= (typeof query !== 'undefined' && query.domain === sec.key) ? 'selected' : '' %>><%= sec.label %></option>
                  <% }); %>
                <% } else { %>
                  <option value="water_sanitation">Water & Sanitation</option>
                  <option value="public_works_infrastructure">Public Works & Infrastructure</option>
                  <option value="public_health">Public Health</option>
                  <option value="agriculture">Agriculture</option>
                  <option value="energy">Energy</option>
                <% } %>
              </select>
            </div>

            <!-- Priority -->
            <div class="filter-group">
              <label for="filterPriority" class="filter-label">Urgency / Priority</label>
              <select id="filterPriority" name="priority" class="filter-select">
                <option value="">All Priorities</option>
                <option value="CRITICAL" <%= (typeof query !== 'undefined' && query.priority === 'CRITICAL') ? 'selected' : '' %>>Critical</option>
                <option value="HIGH" <%= (typeof query !== 'undefined' && query.priority === 'HIGH') ? 'selected' : '' %>>High</option>
                <option value="MEDIUM" <%= (typeof query !== 'undefined' && query.priority === 'MEDIUM') ? 'selected' : '' %>>Medium</option>
                <option value="LOW" <%= (typeof query !== 'undefined' && query.priority === 'LOW') ? 'selected' : '' %>>Low</option>
              </select>
            </div>

            <!-- Location -->
            <div class="filter-group">
              <label for="filterLocation" class="filter-label">Location</label>
              <input 
                type="text" 
                id="filterLocation" 
                name="location" 
                class="filter-input" 
                placeholder="e.g. Indiranagar / Ranchi" 
                value="<%= typeof query !== 'undefined' && query.location ? query.location : '' %>"
              />
            </div>

            <div style="display: flex; align-items: flex-end; gap: var(--space-2);">
              <button type="submit" class="btn btn-primary btn-sm">Filter</button>
              <% if (typeof query !== 'undefined' && (query.q || query.status || query.category || query.domain || query.assignmentStatus || query.priority || query.location)) { %>
                <a href="/authority/problems" class="btn btn-ghost btn-sm">Clear</a>
              <% } %>
            </div>

          </div>
        </form>

        <!-- Problem Triage List -->
        <% if (problems && problems.length > 0) { %>
          
          <div class="dash-problem-list">
            <% problems.forEach(function(prob) { 
              let badgeClass = 'badge-neutral';
              if (prob.status === 'VERIFIED') badgeClass = 'badge-success';
              else if (prob.status === 'CHALLENGE_CREATED') badgeClass = 'badge-primary';
              else if (prob.status === 'UNDER_VERIFICATION') badgeClass = 'badge-warning';
              else if (prob.status === 'REJECTED') badgeClass = 'badge-danger';

              let prioBadge = 'badge-neutral';
              const urgencyVal = (prob.aiClassification && prob.aiClassification.urgency) || prob.priority || 'MEDIUM';
              if (urgencyVal === 'CRITICAL') prioBadge = 'badge-danger';
              else if (urgencyVal === 'HIGH') prioBadge = 'badge-warning';
              else if (urgencyVal === 'MEDIUM') prioBadge = 'badge-primary';

              let assignBadge = 'badge-neutral';
              let assignText = 'Pending';
              if (prob.assignmentStatus === 'assigned') {
                assignBadge = 'badge-success';
                assignText = 'Assigned';
              } else if (prob.assignmentStatus === 'needs_review') {
                assignBadge = 'badge-warning';
                assignText = 'Needs Review';
              } else if (prob.assignmentStatus === 'verified') {
                assignBadge = 'badge-primary';
                assignText = 'Verified';
              }
                const rawThumb = (prob.images && prob.images.length > 0) ? prob.images[0] : null;
                let cleanThumb = rawThumb;
                if (cleanThumb && typeof cleanThumb === 'string') {
                  cleanThumb = (cleanThumb.startsWith('http') || cleanThumb.startsWith('/')) ? cleanThumb : '/' + cleanThumb;
                }
              %>
              <a href="/authority/problems/<%= prob._id %>" class="dash-problem-card" style="padding: var(--space-4) var(--space-5); gap: var(--space-4);">
                <div style="display: flex; align-items: center; gap: var(--space-4); min-width: 0; flex: 1;">
                  <% if (cleanThumb) { %>
                    <div style="width: 64px; height: 64px; border-radius: var(--radius-md); overflow: hidden; flex-shrink: 0; border: 1px solid var(--color-border); background: var(--color-surface-soft);">
                      <img 
                        src="<%= cleanThumb %>" 
                        alt="<%= prob.title %> evidence photo" 
                        loading="lazy" 
                        style="width: 100%; height: 100%; object-fit: cover;"
                        onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                      />
                      <div style="display: none; width: 100%; height: 100%; align-items: center; justify-content: center; color: var(--color-text-muted);">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                      </div>
                    </div>
                  <% } else { %>
                    <div style="width: 64px; height: 64px; border-radius: var(--radius-md); overflow: hidden; flex-shrink: 0; border: 1px dashed var(--color-border); background: var(--color-surface-soft); display: flex; flex-direction: column; align-items: center; justify-content: center; color: var(--color-text-muted); font-size: 0.625rem; text-align: center; gap: 2px;">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="opacity: 0.6;"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                      <span>No photo</span>
                    </div>
                  <% } %>
                  
                  <div class="dash-problem-info" style="flex: 1; min-width: 0;">
                    <div style="display: flex; align-items: center; flex-wrap: wrap; gap: var(--space-2); margin-bottom: 4px;">
                      <span class="badge badge-primary" style="font-size: 0.6875rem;">
                        <%= (prob.aiClassification && prob.aiClassification.domain) ? prob.aiClassification.domain.replace(/_/g, ' ').toUpperCase() : prob.category %>
                      </span>
                      <% if (prob.aiClassification && prob.aiClassification.category) { %>
                        <span class="badge badge-neutral" style="font-size: 0.6875rem;">
                          <%= prob.aiClassification.category.replace(/_/g, ' ') %>
                        </span>
                      <% } %>
                      <span class="badge <%= prioBadge %>" style="font-size: 0.6875rem;"><%= urgencyVal %> Urgency</span>
                      <span class="badge <%= assignBadge %>" style="font-size: 0.6875rem;"><%= assignText %></span>
                      <span class="badge <%= badgeClass %>" style="font-size: 0.6875rem;"><%= prob.status.replace(/_/g, ' ') %></span>
                      <% if (prob.aiClassification && prob.aiClassification.confidence) { %>
                        <span style="font-size: 0.6875rem; color: var(--color-text-muted);">
                          ⚡ <%= Math.round(prob.aiClassification.confidence * 100) %>% AI Confidence
                        </span>
                      <% } %>
                    </div>
                    
                    <span class="dash-problem-title" style="font-size: var(--font-size-base);"><%= prob.title %></span>
                    
                    <div class="dash-problem-meta" style="margin-top: 4px;">
                      <span>📍 <%= prob.location %></span>
                      <span>&bull;</span>
                      <span>👥 <%= prob.supporters ? prob.supporters.length : 1 %> Supporters</span>
                      <span>&bull;</span>
                      <span>Reported by <%= prob.reportedBy ? prob.reportedBy.name : 'Citizen' %></span>
                      <span>&bull;</span>
                      <span>Submitted <%= new Date(prob.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></span>
                      <% if (prob.assignmentReason) { %>
                        <span>&bull;</span>
                        <span style="font-style: italic; color: var(--color-text-muted);"><%= prob.assignmentReason %></span>
                      <% } %>
                    </div>
                  </div>
                </div>
                
                <div class="dash-problem-side">
                  <span class="btn btn-primary btn-sm">Triage & Actions &rarr;</span>
                </div>
              </a>
            <% }); %>
          </div>

        <% } else { %>
          
          <div class="state-box">
            <svg class="state-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
            </svg>
            <h2 class="state-title">No problems match your triage filter</h2>
            <p class="state-desc">
              Try adjusting your search criteria or clear active filters.
            </p>
            <a href="/authority/problems" class="btn btn-secondary btn-sm">Reset Filters</a>
          </div>

        <% } %>

      </div>
    </main>

  </div>

  <!-- Footer -->
  <%- include('../partials/footer') %>

  <script src="/js/dashboard.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
