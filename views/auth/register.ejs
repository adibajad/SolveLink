<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Create Account — SolveLink</title>
  <meta name="description" content="Register your SolveLink account as a citizen, government authority, university researcher, or industry innovator.">
  
  <link rel="stylesheet" href="/css/global.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/forms.css">
  <link rel="stylesheet" href="/css/responsive.css">
</head>
<body>

  <!-- Navigation Bar -->
  <%- include('../partials/navbar', { activePath: '/auth/register' }) %>

  <!-- Main Registration Container -->
  <main id="main-content" class="main-content auth-section">
    <div class="container">
      <div class="auth-card auth-card-wide">
        
        <!-- Auth Header -->
        <div class="auth-header">
          <div class="auth-header-brand">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <circle cx="5" cy="6" r="3" fill="#7B2340" />
              <circle cx="19" cy="6" r="3" fill="#C28B38" />
              <circle cx="12" cy="18" r="3.5" fill="#7B2340" />
              <line x1="7.5" y1="6" x2="16.5" y2="6" stroke="#7B2340" stroke-width="1.8" stroke-linecap="round" />
              <line x1="6.8" y1="8.5" x2="10.5" y2="15.5" stroke="#7B2340" stroke-width="1.8" stroke-linecap="round" />
              <line x1="17.2" y1="8.5" x2="13.5" y2="15.5" stroke="#C28B38" stroke-width="1.8" stroke-linecap="round" />
            </svg>
          </div>
          <h1 class="auth-title">Join SolveLink</h1>
          <p class="auth-subtitle">Select your role to participate in the civic innovation ecosystem</p>
        </div>

        <!-- Auth Body -->
        <div class="auth-body">
          
          <!-- Error Alert -->
          <% if (typeof error !== 'undefined' && error) { %>
            <div class="form-alert form-alert-error" role="alert">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
              </svg>
              <span><%= error %></span>
            </div>
          <% } %>

          <%
            const currentData = typeof formData !== 'undefined' ? formData : {};
            const currentRole = currentData.role || 'citizen';
          %>

          <!-- Registration Form -->
          <form action="/auth/register" method="POST" id="registerForm" novalidate>
            
            <!-- 1. Stakeholder Role Selection -->
            <div class="form-group">
              <label class="form-label">I am joining as a:</label>
              
              <div class="role-selector-grid">
                
                <!-- Citizen -->
                <label class="role-option">
                  <input type="radio" name="role" value="citizen" <%= currentRole === 'citizen' ? 'checked' : '' %>>
                  <div class="role-option-box">
                    <svg class="role-option-icon" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                      <circle cx="12" cy="7" r="4"></circle>
                    </svg>
                    <span class="role-option-title">Citizen</span>
                  </div>
                </label>

                <!-- University / Researcher -->
                <label class="role-option">
                  <input type="radio" name="role" value="university" <%= currentRole === 'university' ? 'checked' : '' %>>
                  <div class="role-option-box">
                    <svg class="role-option-icon" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
                      <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
                    </svg>
                    <span class="role-option-title">University / Lab</span>
                  </div>
                </label>

                <!-- Authority -->
                <label class="role-option">
                  <input type="radio" name="role" value="authority" <%= currentRole === 'authority' ? 'checked' : '' %>>
                  <div class="role-option-box">
                    <svg class="role-option-icon" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    </svg>
                    <span class="role-option-title">Authority</span>
                  </div>
                </label>

                <!-- Industry -->
                <label class="role-option">
                  <input type="radio" name="role" value="industry" <%= currentRole === 'industry' ? 'checked' : '' %>>
                  <div class="role-option-box">
                    <svg class="role-option-icon" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"></path>
                    </svg>
                    <span class="role-option-title">Industry Partner</span>
                  </div>
                </label>

              </div>
            </div>

            <!-- 2. Core User Fields -->
            <div class="form-row">
              <div class="form-group">
                <label for="regName" class="form-label">Full Name / Official Name</label>
                <input 
                  type="text" 
                  id="regName" 
                  name="name" 
                  class="form-input" 
                  placeholder="e.g. Dr. Rajesh Kumar / Ananya Roy" 
                  value="<%= currentData.name || '' %>" 
                  required 
                  autocomplete="name"
                />
              </div>

              <div class="form-group">
                <label for="regEmail" class="form-label">Email Address</label>
                <input 
                  type="email" 
                  id="regEmail" 
                  name="email" 
                  class="form-input" 
                  placeholder="name@domain.edu / name@gov.in" 
                  value="<%= currentData.email || '' %>" 
                  required 
                  autocomplete="email"
                />
              </div>
            </div>

            <!-- Password Field -->
            <div class="form-group">
              <label for="regPassword" class="form-label">Password</label>
              <div class="password-input-wrapper">
                <input 
                  type="password" 
                  id="regPassword" 
                  name="password" 
                  class="form-input" 
                  placeholder="Minimum 6 characters" 
                  minlength="6" 
                  required 
                  autocomplete="new-password"
                />
                <button 
                  type="button" 
                  class="password-toggle-btn" 
                  aria-label="Show password" 
                  aria-controls="regPassword" 
                  title="Show password"
                >
                  <svg class="eye-icon eye-show" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                    <circle cx="12" cy="12" r="3"></circle>
                  </svg>
                  <svg class="eye-icon eye-hide" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display: none;">
                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                    <line x1="1" y1="1" x2="23" y2="23"></line>
                  </svg>
                </button>
              </div>
              <span class="form-hint">Use at least 6 characters with a combination of letters and numbers.</span>
            </div>

            <!-- 3. Conditional / Contextual Fields -->

            <!-- Authority Structured Profile Fields -->
            <div id="authorityFieldsContainer" style="<%= currentRole === 'authority' ? '' : 'display: none;' %>">
              <div class="form-group">
                <label for="regSector" class="form-label">
                  <span>Authority Sector <span class="required-indicator">*</span></span>
                </label>
                <select id="regSector" name="authoritySector" class="form-select">
                  <option value="">-- Select Authority Sector --</option>
                  <option value="water_sanitation" <%= currentData.authoritySector === 'water_sanitation' ? 'selected' : '' %>>Water & Sanitation</option>
                  <option value="municipal_corporation" <%= currentData.authoritySector === 'municipal_corporation' ? 'selected' : '' %>>Municipal Corporation</option>
                  <option value="public_works_infrastructure" <%= currentData.authoritySector === 'public_works_infrastructure' ? 'selected' : '' %>>Public Works & Infrastructure</option>
                  <option value="public_health" <%= currentData.authoritySector === 'public_health' ? 'selected' : '' %>>Public Health</option>
                  <option value="agriculture" <%= currentData.authoritySector === 'agriculture' ? 'selected' : '' %>>Agriculture</option>
                  <option value="energy" <%= currentData.authoritySector === 'energy' ? 'selected' : '' %>>Energy</option>
                  <option value="waste_management" <%= currentData.authoritySector === 'waste_management' ? 'selected' : '' %>>Waste Management</option>
                  <option value="education" <%= currentData.authoritySector === 'education' ? 'selected' : '' %>>Education</option>
                  <option value="digital_governance_it" <%= currentData.authoritySector === 'digital_governance_it' ? 'selected' : '' %>>Digital Governance & IT</option>
                  <option value="environment_forest" <%= currentData.authoritySector === 'environment_forest' ? 'selected' : '' %>>Environment & Forest</option>
                  <option value="transport" <%= currentData.authoritySector === 'transport' ? 'selected' : '' %>>Transport</option>
                  <option value="urban_development" <%= currentData.authoritySector === 'urban_development' ? 'selected' : '' %>>Urban Development</option>
                  <option value="rural_development" <%= currentData.authoritySector === 'rural_development' ? 'selected' : '' %>>Rural Development</option>
                  <option value="public_safety" <%= currentData.authoritySector === 'public_safety' ? 'selected' : '' %>>Public Safety</option>
                  <option value="other" <%= currentData.authoritySector === 'other' ? 'selected' : '' %>>Other</option>
                </select>
              </div>

              <div class="form-group">
                <label for="regDept" class="form-label">
                  <span>Specific Department / Office</span>
                  <span class="form-label-optional">Official Name</span>
                </label>
                <input 
                  type="text" 
                  id="regDept" 
                  name="department" 
                  class="form-input" 
                  placeholder="e.g. Municipal Water Supply Department / PWD Road Maintenance Cell" 
                  value="<%= currentData.department || currentData.organization || '' %>"
                />
              </div>

              <div class="form-group">
                <label for="regJurisdiction" class="form-label">
                  <span>Official Jurisdiction / District</span>
                  <span class="form-label-optional">Target Area</span>
                </label>
                <input 
                  type="text" 
                  id="regJurisdiction" 
                  name="jurisdiction" 
                  class="form-input" 
                  placeholder="e.g. Ranchi District, Latehar, Indiranagar Ward 14" 
                  value="<%= currentData.jurisdiction || currentData.location || '' %>"
                />
              </div>
            </div>

            <!-- University Structured Profile Fields -->
            <div id="universityFieldsContainer" style="<%= currentRole === 'university' ? '' : 'display: none;' %>">
              <div class="form-group">
                <label for="regUniOrg" class="form-label">University / Institute / Lab Name</label>
                <input 
                  type="text" 
                  id="regUniOrg" 
                  name="organization" 
                  class="form-input" 
                  placeholder="e.g. BIT Mesra / Environmental Robotics Lab" 
                  value="<%= currentData.organization || '' %>"
                />
              </div>

              <div class="form-group">
                <label for="regUniDomains" class="form-label">
                  <span>Research & Engineering Domains</span>
                  <span class="form-label-optional">Comma-separated</span>
                </label>
                <input 
                  type="text" 
                  id="regUniDomains" 
                  name="domains" 
                  class="form-input" 
                  placeholder="e.g. AI & ML, IoT, Civil Engineering, Water & Sanitation, Renewable Energy" 
                  value="<%= currentData.domains || '' %>"
                />
              </div>

              <div class="form-group">
                <label for="regUniSkills" class="form-label">
                  <span>Core Technical Skills</span>
                  <span class="form-label-optional">Comma-separated</span>
                </label>
                <input 
                  type="text" 
                  id="regUniSkills" 
                  name="skills" 
                  class="form-input" 
                  placeholder="e.g. Computer Vision, Embedded C, Water Treatment, Structural Mechanics" 
                  value="<%= currentData.skills || '' %>"
                />
              </div>

              <div class="form-group">
                <label for="regUniTech" class="form-label">
                  <span>Technologies & Tools</span>
                  <span class="form-label-optional">Comma-separated</span>
                </label>
                <input 
                  type="text" 
                  id="regUniTech" 
                  name="technologies" 
                  class="form-input" 
                  placeholder="e.g. ESP32, Python, LoRaWAN, TensorFlow Lite, CAD" 
                  value="<%= currentData.technologies || '' %>"
                />
              </div>
            </div>

            <!-- Industry Structured Profile Fields -->
            <div id="industryFieldsContainer" style="<%= currentRole === 'industry' ? '' : 'display: none;' %>">
              <div class="form-group">
                <label for="regIndOrg" class="form-label">Enterprise / Company Name</label>
                <input 
                  type="text" 
                  id="regIndOrg" 
                  name="organization" 
                  class="form-input" 
                  placeholder="e.g. Smart Systems Automation Pvt Ltd" 
                  value="<%= currentData.organization || '' %>"
                />
              </div>

              <div class="form-group">
                <label for="regIndSector" class="form-label">Industry Sector</label>
                <select id="regIndSector" name="industrySector" class="form-select">
                  <option value="">-- Select Industry Sector --</option>
                  <option value="water_sanitation" <%= currentData.industrySector === 'water_sanitation' ? 'selected' : '' %>>Water, Filtration & Piping</option>
                  <option value="public_works_infrastructure" <%= currentData.industrySector === 'public_works_infrastructure' ? 'selected' : '' %>>Civil Infrastructure & Construction</option>
                  <option value="energy" <%= currentData.industrySector === 'energy' ? 'selected' : '' %>>Renewable Energy & Power Systems</option>
                  <option value="manufacturing" <%= currentData.industrySector === 'manufacturing' ? 'selected' : '' %>>Hardware Manufacturing & Electronics</option>
                  <option value="public_health" <%= currentData.industrySector === 'public_health' ? 'selected' : '' %>>Biomedical & Healthcare Devices</option>
                  <option value="waste_management" <%= currentData.industrySector === 'waste_management' ? 'selected' : '' %>>Waste Recycling & Processing</option>
                  <option value="agriculture" <%= currentData.industrySector === 'agriculture' ? 'selected' : '' %>>Agri-Tech & Cold Chain</option>
                  <option value="digital_governance_it" <%= currentData.industrySector === 'digital_governance_it' ? 'selected' : '' %>>IT, Telecom & SCADA</option>
                  <option value="other" <%= currentData.industrySector === 'other' ? 'selected' : '' %>>Other</option>
                </select>
              </div>

              <div class="form-group">
                <label for="regIndCap" class="form-label">
                  <span>Industrial Implementation Capabilities</span>
                  <span class="form-label-optional">Comma-separated</span>
                </label>
                <input 
                  type="text" 
                  id="regIndCap" 
                  name="capabilities" 
                  class="form-input" 
                  placeholder="e.g. Pilot Implementation, Hardware Fabrication, Field Validation, Manufacturing Scale" 
                  value="<%= currentData.capabilities || '' %>"
                />
              </div>

              <div class="form-group">
                <label for="regIndTech" class="form-label">
                  <span>Technologies & Production Capabilities</span>
                  <span class="form-label-optional">Comma-separated</span>
                </label>
                <input 
                  type="text" 
                  id="regIndTech" 
                  name="technologies" 
                  class="form-input" 
                  placeholder="e.g. PCB Assembly, CNC Machining, IoT Enclosures, Solar Inverters" 
                  value="<%= currentData.technologies || '' %>"
                />
              </div>
            </div>

            <!-- Citizen & General Location Field -->
            <div class="form-group" id="generalLocationContainer">
              <label for="regLocation" class="form-label">
                <span>Location / District</span>
                <span class="form-label-optional">City / State</span>
              </label>
              <input 
                type="text" 
                id="regLocation" 
                name="location" 
                class="form-input" 
                placeholder="e.g. Ranchi, Jharkhand" 
                value="<%= currentData.location || '' %>"
              />
            </div>

            <!-- Submit Button -->
            <button type="submit" class="btn btn-primary btn-block btn-lg" style="margin-top: var(--space-4);">
              Create Account
            </button>
          </form>

        </div>

        <!-- Auth Footer -->
        <div class="auth-footer">
          <span>Already have an account? <a href="/auth/login">Sign in</a></span>
        </div>

      </div>
    </div>
  </main>

  <!-- Reusable Footer -->
  <%- include('../partials/footer') %>

  <!-- Dynamic Role Field Switching Script -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('registerForm');
      const roleInputs = document.querySelectorAll('input[name="role"]');
      const authContainer = document.getElementById('authorityFieldsContainer');
      const uniContainer = document.getElementById('universityFieldsContainer');
      const indContainer = document.getElementById('industryFieldsContainer');

      function setContainerState(container, isActive) {
        if (!container) return;
        container.style.display = isActive ? 'block' : 'none';
        const fields = container.querySelectorAll('input, select, textarea');
        fields.forEach(field => {
          field.disabled = !isActive;
        });
      }

      function updateFields(role) {
        setContainerState(authContainer, role === 'authority');
        setContainerState(uniContainer, role === 'university');
        setContainerState(indContainer, role === 'industry');
      }

      roleInputs.forEach(input => {
        if (input.checked) updateFields(input.value);
        input.addEventListener('change', (e) => {
          updateFields(e.target.value);
        });
      });

      // Synchronize disabled states immediately on load
      const checkedRole = document.querySelector('input[name="role"]:checked');
      if (checkedRole) {
        updateFields(checkedRole.value);
      }

      // Synchronize disabled state right before submit to prevent submitting inactive fields
      if (form) {
        form.addEventListener('submit', () => {
          const selectedRoleInput = document.querySelector('input[name="role"]:checked');
          const currentRole = selectedRoleInput ? selectedRoleInput.value : 'citizen';
          updateFields(currentRole);
        });
      }
    });
  </script>
  <script src="/js/main.js"></script>
</body>
</html>
