<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reset Password — SolveLink</title>
  <meta name="description" content="Set a new password for your SolveLink account.">
  
  <link rel="stylesheet" href="/css/global.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/forms.css">
  <link rel="stylesheet" href="/css/responsive.css">
</head>
<body>

  <!-- Navigation Bar -->
  <%- include('../partials/navbar', { activePath: '/auth/login' }) %>

  <!-- Main Container -->
  <main id="main-content" class="main-content auth-section">
    <div class="container">
      <div class="auth-card">
        
        <!-- Auth Header -->
        <div class="auth-header">
          <div class="auth-header-brand">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <circle cx="5" cy="6" r="3" fill="#7B2340" />
              <circle cx="19" cy="6" r="3" fill="#C28B38" />
              <circle cx="12" cy="18" r="3.5" fill="#7B2340" />
              <line x1="7.5" y1="6" x2="16.5" y2="6" stroke="#7B2340" stroke-width="1.8" stroke-linecap="round" />
              <line x1="6.8" y1="8.5" x2="10.5" y2="15.5" stroke="#7B2340" stroke-width="1.8" stroke-linecap="round" />
              <line x1="17.2" y1="8.5" x2="13.5" y2="15.5" stroke="#C28B38" stroke-width="1.8" stroke-linecap="round" />
            </svg>
          </div>
          <h1 class="auth-title">Reset Password</h1>
          <p class="auth-subtitle">
            Set a new secure password for your account
          </p>
        </div>

        <!-- Auth Body -->
        <div class="auth-body">
          
          <!-- Error / Info Alerts -->
          <% if (typeof error !== 'undefined' && error) { %>
            <div class="form-alert form-alert-error" role="alert">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
              </svg>
              <span><%= error %></span>
            </div>
          <% } %>

          <% if (typeof info !== 'undefined' && info) { %>
            <div class="form-alert form-alert-success" role="status">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
              </svg>
              <span><%= info %></span>
            </div>
          <% } %>

          <!-- Reset Password Form -->
          <form action="/auth/reset-password" method="POST" id="resetPasswordForm" novalidate>
            
            <!-- Email Field -->
            <div class="form-group">
              <label for="resetEmail" class="form-label">Email Address</label>
              <input 
                type="email" 
                id="resetEmail" 
                name="email" 
                class="form-input" 
                placeholder="name@organization.gov.in" 
                value="<%= typeof email !== 'undefined' ? email : '' %>" 
                required 
                autocomplete="email"
                <%= (typeof email !== 'undefined' && email) ? '' : 'autofocus' %>
              />
            </div>

            <!-- New Password Field -->
            <div class="form-group">
              <label for="newPassword" class="form-label">New Password</label>
              <div class="password-input-wrapper">
                <input 
                  type="password" 
                  id="newPassword" 
                  name="password" 
                  class="form-input" 
                  placeholder="Minimum 6 characters" 
                  minlength="6" 
                  required 
                  autocomplete="new-password"
                  <%= (typeof email !== 'undefined' && email) ? 'autofocus' : '' %>
                />
                <button 
                  type="button" 
                  class="password-toggle-btn" 
                  aria-label="Show password" 
                  aria-controls="newPassword" 
                  title="Show password"
                >
                  <svg class="eye-icon eye-show" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                    <circle cx="12" cy="12" r="3"></circle>
                  </svg>
                  <svg class="eye-icon eye-hide" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display: none;">
                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                    <line x1="1" y1="1" x2="23" y2="23"></line>
                  </svg>
                </button>
              </div>
            </div>

            <!-- Confirm New Password Field -->
            <div class="form-group">
              <label for="confirmPassword" class="form-label">Confirm New Password</label>
              <div class="password-input-wrapper">
                <input 
                  type="password" 
                  id="confirmPassword" 
                  name="confirmPassword" 
                  class="form-input" 
                  placeholder="Re-enter your new password" 
                  minlength="6" 
                  required 
                  autocomplete="new-password"
                />
                <button 
                  type="button" 
                  class="password-toggle-btn" 
                  aria-label="Show password" 
                  aria-controls="confirmPassword" 
                  title="Show password"
                >
                  <svg class="eye-icon eye-show" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8z"></path>
                    <circle cx="12" cy="12" r="3"></circle>
                  </svg>
                  <svg class="eye-icon eye-hide" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display: none;">
                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                    <line x1="1" y1="1" x2="23" y2="23"></line>
                  </svg>
                </button>
              </div>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="btn btn-primary btn-block btn-lg" style="margin-top: var(--space-4);">
              Reset Password
            </button>
          </form>

        </div>

        <!-- Auth Footer -->
        <div class="auth-footer">
          <span>Remember your password? <a href="/auth/login">Back to sign in</a></span>
        </div>

      </div>
    </div>
  </main>

  <!-- Reusable Footer -->
  <%- include('../partials/footer') %>

  <script src="/js/main.js"></script>
</body>
</html>
