<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Administrator Console Login — SolveLink</title>
  <meta name="robots" content="noindex, nofollow">
  
  <link rel="stylesheet" href="/css/global.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/forms.css">
  <link rel="stylesheet" href="/css/responsive.css">
</head>
<body>

  <!-- Navigation Bar -->
  <%- include('../partials/navbar', { activePath: '/admin/login' }) %>

  <!-- Main Login Container -->
  <main id="main-content" class="main-content auth-section">
    <div class="container">
      <div class="auth-card" style="max-width: 460px; border-top: 4px solid var(--color-primary, #7B2340);">
        
        <!-- Auth Header -->
        <div class="auth-header">
          <div class="auth-header-brand" style="display: flex; justify-content: center; margin-bottom: var(--space-3);">
            <div style="width: 52px; height: 52px; border-radius: 12px; background: rgba(123, 35, 64, 0.08); display: flex; align-items: center; justify-content: center; color: var(--color-primary, #7B2340);">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="3"></circle>
                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
              </svg>
            </div>
          </div>
          <span class="badge badge-primary" style="margin-bottom: var(--space-2); font-size: 0.75rem; letter-spacing: 0.05em;">ADMINISTRATIVE CONSOLE</span>
          <h1 class="auth-title">SolveLink Platform Control</h1>
          <p class="auth-subtitle">Restricted to authorized system administrators</p>
        </div>

        <!-- Auth Body -->
        <div class="auth-body">
          
          <!-- Error Alert Banner -->
          <% if (typeof error !== 'undefined' && error) { %>
            <div class="form-alert form-alert-error" role="alert">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
              </svg>
              <span><%= error %></span>
            </div>
          <% } %>

          <!-- Admin Login Form -->
          <form action="/admin/login" method="POST" novalidate>

            <!-- Admin Email Field -->
            <div class="form-group">
              <label for="email" class="form-label">Administrator Email</label>
              <input 
                type="email" 
                id="email" 
                name="email" 
                class="form-input" 
                placeholder="admin@solvelink.gov.in" 
                value="<%= typeof email !== 'undefined' ? email : '' %>" 
                required 
                autocomplete="email"
                autofocus
              />
            </div>

            <!-- Password Field -->
            <div class="form-group">
              <label for="password" class="form-label">Administrator Password</label>
              <input 
                type="password" 
                id="password" 
                name="password" 
                class="form-input" 
                placeholder="••••••••••••" 
                required 
                autocomplete="current-password"
              />
            </div>

            <!-- Submit Button -->
            <button type="submit" class="btn btn-primary btn-block btn-lg" style="margin-top: var(--space-4);">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px;">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
              Authenticate as Administrator
            </button>
          </form>

          <div style="margin-top: var(--space-6); text-align: center; border-top: 1px solid var(--color-border, #E2E8F0); padding-top: var(--space-4);">
            <p class="text-muted" style="font-size: var(--font-size-xs); margin-bottom: 0;">
              Standard user or stakeholder? <a href="/auth/login" style="color: var(--color-primary); font-weight: 500;">Go to Stakeholder Sign In &rarr;</a>
            </p>
          </div>

        </div>
      </div>
    </div>
  </main>

  <!-- Site Footer -->
  <%- include('../partials/footer') %>

</body>
</html>
