<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Community Problems — SolveLink</title>
  <meta name="description" content="Discover, review, and support verified civic problem reports submitted by citizens across Jharkhand.">
  
  <link rel="stylesheet" href="/css/global.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/problem.css">
  <link rel="stylesheet" href="/css/responsive.css">
</head>
<body>

  <!-- Navigation Bar -->
  <%- include('../partials/navbar', { activePath: '/problems' }) %>

  <% if (typeof user !== 'undefined' && user) { %>
    <!-- Authenticated Citizen Portal Layout with Permanent Sidebar -->
    <div class="dashboard-layout">
      
      <!-- Reusable Sidebar -->
      <%- include('../partials/sidebar', { role: user.role || 'citizen', activePath: '/problems' }) %>

      <!-- Main Dashboard Content Area -->
      <main id="main-content" class="dashboard-main">
        <div class="dashboard-content">
          
          <!-- Page Header Topbar -->
          <div class="dashboard-topbar">
            <div>
              <div style="display: flex; align-items: center; gap: var(--space-2); margin-bottom: var(--space-1);">
                <span class="badge badge-primary">Civic Discovery & Review</span>
                <span class="badge badge-neutral">Jharkhand State</span>
              </div>
              <h1 class="dashboard-welcome">Community Problems</h1>
              <p class="dashboard-sub">
                Discover problems reported by citizens across Jharkhand. Review, support and help identify issues that need attention.
              </p>
            </div>
            <div>
              <a href="/citizen/report-problem" class="btn btn-primary btn-md">
                + Report a Problem
              </a>
            </div>
          </div>

          <!-- Civic Review Purpose Banner -->
          <div class="community-purpose-banner" style="margin-bottom: var(--space-6);">
            <div style="display: flex; align-items: flex-start; gap: var(--space-3);">
              <div class="purpose-icon-box" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                  <circle cx="9" cy="7" r="4"></circle>
                  <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                  <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
              </div>
              <div style="font-size: var(--font-size-xs); color: var(--color-text); line-height: 1.5;">
                <strong>Why Community Review Matters:</strong> Community discovery surfaces genuine problems, detects duplicate reports, and highlights issues affecting more citizens. Highly upvoted problems receive prioritized authority verification.
              </div>
            </div>
          </div>

          <!-- Real Database Statistics Row -->
          <div class="community-stats-grid">
            <div class="community-stat-card">
              <div class="community-stat-num"><%= stats.totalReported %></div>
              <div class="community-stat-label">Problems Reported</div>
            </div>
            <div class="community-stat-card">
              <div class="community-stat-num"><%= stats.communitySupported %></div>
              <div class="community-stat-label">Community Supported</div>
            </div>
            <div class="community-stat-card">
              <div class="community-stat-num"><%= stats.underReview %></div>
              <div class="community-stat-label">Under Authority Review</div>
            </div>
            <div class="community-stat-card">
              <div class="community-stat-num"><%= stats.verified %></div>
              <div class="community-stat-label">Verified Problems</div>
            </div>
          </div>

          <!-- Top Filter Bar Form -->
          <div class="community-filter-card">
            <form action="/problems" method="GET" id="communityFilterForm">
              <div class="community-filter-grid">
                
                <!-- 1. Search Keyword -->
                <div class="community-filter-item">
                  <label for="filterSearch" class="community-filter-label">Search Problems</label>
                  <input 
                    type="text" 
                    id="filterSearch" 
                    name="q" 
                    class="form-input" 
                    placeholder="Search keywords, street name..." 
                    value="<%= typeof query !== 'undefined' && query.q ? query.q : '' %>"
                  />
                </div>

                <!-- 2. Category Filter -->
                <div class="community-filter-item">
                  <label for="filterCategory" class="community-filter-label">Category</label>
                  <select id="filterCategory" name="category" class="form-select">
                    <option value="">All Categories</option>
                    <% categories.forEach(function(cat) { %>
                      <option value="<%= cat %>" <%= (typeof query !== 'undefined' && query.category === cat) ? 'selected' : '' %>><%= cat %></option>
                    <% }); %>
                  </select>
                </div>

                <!-- 3. District / Location Filter -->
                <div class="community-filter-item">
                  <label for="filterLocation" class="community-filter-label">District / Location</label>
                  <input 
                    type="text" 
                    id="filterLocation" 
                    name="location" 
                    class="form-input" 
                    placeholder="e.g. Ranchi, Ward 14" 
                    value="<%= typeof query !== 'undefined' && query.location ? query.location : '' %>"
                  />
                </div>

                <!-- 4. Status Filter -->
                <div class="community-filter-item">
                  <label for="filterStatus" class="community-filter-label">Status</label>
                  <select id="filterStatus" name="status" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="REPORTED" <%= (typeof query !== 'undefined' && query.status === 'REPORTED') ? 'selected' : '' %>>Reported</option>
                    <option value="COMMUNITY_REVIEW" <%= (typeof query !== 'undefined' && query.status === 'COMMUNITY_REVIEW') ? 'selected' : '' %>>Community Review</option>
                    <option value="UNDER_VERIFICATION" <%= (typeof query !== 'undefined' && query.status === 'UNDER_VERIFICATION') ? 'selected' : '' %>>Under Authority Review</option>
                    <option value="VERIFIED" <%= (typeof query !== 'undefined' && query.status === 'VERIFIED') ? 'selected' : '' %>>Verified</option>
                    <option value="CHALLENGE_CREATED" <%= (typeof query !== 'undefined' && query.status === 'CHALLENGE_CREATED') ? 'selected' : '' %>>Innovation Challenge</option>
                  </select>
                </div>

                <!-- 5. Priority Filter -->
                <div class="community-filter-item">
                  <label for="filterPriority" class="community-filter-label">Priority</label>
                  <select id="filterPriority" name="priority" class="form-select">
                    <option value="">All Priorities</option>
                    <option value="CRITICAL" <%= (typeof query !== 'undefined' && query.priority === 'CRITICAL') ? 'selected' : '' %>>Critical</option>
                    <option value="HIGH" <%= (typeof query !== 'undefined' && query.priority === 'HIGH') ? 'selected' : '' %>>High</option>
                    <option value="MEDIUM" <%= (typeof query !== 'undefined' && query.priority === 'MEDIUM') ? 'selected' : '' %>>Medium</option>
                    <option value="LOW" <%= (typeof query !== 'undefined' && query.priority === 'LOW') ? 'selected' : '' %>>Low</option>
                  </select>
                </div>

                <!-- 6. Sort By -->
                <div class="community-filter-item">
                  <label for="filterSort" class="community-filter-label">Sort By</label>
                  <select id="filterSort" name="sort" class="form-select">
                    <option value="newest" <%= (typeof query === 'undefined' || !query.sort || query.sort === 'newest') ? 'selected' : '' %>>Newest First</option>
                    <option value="most_supported" <%= (typeof query !== 'undefined' && query.sort === 'most_supported') ? 'selected' : '' %>>Most Supported</option>
                    <option value="highest_priority" <%= (typeof query !== 'undefined' && query.sort === 'highest_priority') ? 'selected' : '' %>>Highest Priority</option>
                    <option value="recently_updated" <%= (typeof query !== 'undefined' && query.sort === 'recently_updated') ? 'selected' : '' %>>Recently Updated</option>
                  </select>
                </div>

                <!-- Filter Buttons -->
                <div class="community-filter-actions" style="grid-column: span 2; display: flex; align-items: flex-end; gap: var(--space-2);">
                  <button type="submit" class="btn btn-primary btn-sm" style="flex: 1;">Search</button>
                  <a href="/problems" class="btn btn-outline btn-sm">Reset</a>
                </div>

              </div>
            </form>
          </div>

          <!-- Problem Results Count Header -->
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--space-4); flex-wrap: wrap; gap: var(--space-2);">
            <h2 style="font-size: var(--font-size-md); font-weight: var(--font-weight-bold); color: var(--color-text);">
              Showing <%= problems.length %> Community <%= problems.length === 1 ? 'Report' : 'Reports' %>
            </h2>
            <% if (typeof query !== 'undefined' && (query.q || query.category || query.location || query.status || query.priority || (query.sort && query.sort !== 'newest'))) { %>
              <div style="display: flex; align-items: center; gap: var(--space-2); font-size: var(--font-size-xs); color: var(--color-text-muted);">
                <span>Filtered View</span>
                <span>&bull;</span>
                <a href="/problems" style="color: var(--color-primary); font-weight: var(--font-weight-semibold);">Clear All Filters</a>
              </div>
            <% } %>
          </div>

          <!-- Problem Card Grid (Responsive 3-Column) -->
          <% if (problems && problems.length > 0) { %>
            <div class="community-problems-grid">
              <% problems.forEach(function(prob) { 
                const thumbImg = (prob.images && prob.images.length > 0) ? prob.images[0] : null;
                const supporterCount = prob.supporters ? prob.supporters.length : 1;
                const isUserSupporter = typeof currentUserId !== 'undefined' && currentUserId && prob.supporters && prob.supporters.some(s => (s._id || s).toString() === currentUserId);

                let statusBadgeClass = 'badge-neutral';
                let statusText = 'Reported';
                if (prob.status === 'VERIFIED') {
                  statusBadgeClass = 'badge-success';
                  statusText = 'Verified';
                } else if (prob.status === 'CHALLENGE_CREATED') {
                  statusBadgeClass = 'badge-primary';
                  statusText = 'Innovation Challenge';
                } else if (prob.status === 'UNDER_VERIFICATION') {
                  statusBadgeClass = 'badge-warning';
                  statusText = 'Under Review';
                } else if (prob.status === 'COMMUNITY_REVIEW') {
                  statusBadgeClass = 'badge-neutral';
                  statusText = 'Community Review';
                }

                let priorityBadgeClass = 'priority-med';
                if (prob.priority === 'CRITICAL' || prob.priority === 'HIGH') priorityBadgeClass = 'priority-high';
                else if (prob.priority === 'LOW') priorityBadgeClass = 'priority-low';
              %>
                <article class="community-problem-card">
                  
                  <!-- Thumbnail with seamless fallback if file is missing -->
                  <% if (thumbImg) { %>
                    <div class="community-card-thumb-container">
                      <img 
                        src="<%= thumbImg %>" 
                        alt="<%= prob.title %> evidence photo" 
                        class="community-card-thumb" 
                        loading="lazy" 
                        onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                      />
                      <div class="community-card-thumb-placeholder" style="display: none;">
                        <svg class="community-card-thumb-placeholder-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                          <circle cx="12" cy="13" r="4"></circle>
                        </svg>
                        <span class="community-card-thumb-placeholder-text">Photo unavailable</span>
                      </div>
                    </div>
                  <% } else { %>
                    <div class="community-card-thumb-placeholder">
                      <svg class="community-card-thumb-placeholder-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                        <circle cx="12" cy="13" r="4"></circle>
                      </svg>
                      <span class="community-card-thumb-placeholder-text">No photo attached</span>
                    </div>
                  <% } %>

                  <div class="community-card-body">
                    
                    <!-- Category & Status Badge Row -->
                    <div class="community-card-badge-row">
                      <span class="badge badge-primary" style="font-size: 0.6875rem;"><%= prob.category %></span>
                      <span class="badge <%= statusBadgeClass %>" style="font-size: 0.6875rem;"><%= statusText %></span>
                    </div>

                    <!-- Problem Title -->
                    <h3 class="community-card-title">
                      <a href="/problems/<%= prob._id %>" style="color: inherit; text-decoration: none;">
                        <%= prob.title %>
                      </a>
                    </h3>

                    <!-- Short Clamped Description -->
                    <p class="community-card-desc">
                      <%= prob.description %>
                    </p>

                    <!-- Location & Reported Date -->
                    <div style="display: flex; align-items: center; justify-content: space-between; gap: var(--space-2); margin-bottom: var(--space-3); flex-wrap: wrap;">
                      <div class="community-card-location" style="margin-bottom: 0;">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink: 0; color: var(--color-text-muted);">
                          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                          <circle cx="12" cy="10" r="3"></circle>
                        </svg>
                        <span><%= prob.location %></span>
                      </div>
                      <span class="community-card-date">
                        Reported <%= prob.createdAt ? new Date(prob.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : 'Recently' %>
                      </span>
                    </div>

                    <!-- Metadata Row: Community Support & Priority -->
                    <div class="community-card-meta-row">
                      <div class="community-support-indicator <%= isUserSupporter ? 'user-supported' : '' %>" id="indicator-<%= prob._id %>" title="<%= supporterCount %> citizens have supported this issue">
                        <span class="support-icon" aria-hidden="true">👍</span>
                        <span class="supporter-count-label" style="font-weight: var(--font-weight-semibold);"><%= supporterCount %> <%= supporterCount === 1 ? 'supporter' : 'supporters' %></span>
                      </div>

                      <div style="display: flex; align-items: center; gap: 4px; font-size: var(--font-size-xs);">
                        <span style="color: var(--color-text-muted);">Priority:</span>
                        <span class="priority-tag <%= priorityBadgeClass %>">
                          <%= prob.priority || 'Medium' %>
                        </span>
                      </div>
                    </div>

                    <!-- Card Footer Actions: View Problem + Support Button -->
                    <div class="community-card-footer" style="display: flex; align-items: center; justify-content: space-between; gap: var(--space-2); padding-top: var(--space-3); border-top: 1px solid var(--color-surface-soft);">
                      <a href="/problems/<%= prob._id %>" class="btn btn-outline btn-sm" style="font-size: var(--font-size-xs); padding: 4px 10px;">
                        View Problem
                      </a>

                      <button 
                        type="button" 
                        class="btn btn-sm btn-card-support <%= isUserSupporter ? 'supported' : '' %>" 
                        data-problem-id="<%= prob._id %>"
                        style="font-size: var(--font-size-xs); padding: 4px 10px;"
                      >
                        <span class="card-support-icon"><%= isUserSupporter ? '✓' : '👍' %></span>
                        <span class="card-support-label"><%= isUserSupporter ? 'Supported' : 'Support' %></span>
                      </button>
                    </div>

                  </div>

                </article>
              <% }); %>
            </div>
          <% } else { %>
            <!-- Empty State -->
            <div class="community-empty-state">
              <div class="empty-icon-circle" aria-hidden="true">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="11" cy="11" r="8"></circle>
                  <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
              </div>
              <h3 style="font-size: var(--font-size-lg); font-weight: var(--font-weight-bold); margin-bottom: var(--space-2);">No community problems found</h3>
              <p style="font-size: var(--font-size-sm); color: var(--color-text-muted); max-width: 480px; margin: 0 auto var(--space-5);">
                No problem reports matched your search keyword or selected filters. Try broadening your criteria or reset the search.
              </p>
              <a href="/problems" class="btn btn-outline btn-sm">Clear Filters</a>
            </div>
          <% } %>

        </div>
      </main>

    </div>
  <% } else { %>
    <!-- Public Visitor Layout -->
    <main id="main-content" class="main-content section">
      <div class="container">
        
        <!-- Page Header -->
        <div class="community-page-header">
          <div style="max-width: 760px;">
            <div style="display: flex; align-items: center; gap: var(--space-2); margin-bottom: var(--space-2);">
              <span class="badge badge-primary">Civic Discovery & Review</span>
              <span class="badge badge-neutral">Jharkhand State</span>
            </div>
            <h1 class="community-page-title">Community Problems</h1>
            <p class="community-page-subtitle">
              Discover problems reported by citizens across Jharkhand. Review, support and help identify issues that need attention.
            </p>
          </div>

          <div class="community-header-actions">
            <a href="/auth/login?redirect=/citizen/report-problem" class="btn btn-primary">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="16"></line>
                <line x1="8" y1="12" x2="16" y2="12"></line>
              </svg>
              <span>Report a Problem</span>
            </a>
          </div>
        </div>

        <!-- Real Database Statistics Row -->
        <div class="community-stats-grid">
          <div class="community-stat-card">
            <div class="community-stat-num"><%= stats.totalReported %></div>
            <div class="community-stat-label">Problems Reported</div>
          </div>
          <div class="community-stat-card">
            <div class="community-stat-num"><%= stats.communitySupported %></div>
            <div class="community-stat-label">Community Supported</div>
          </div>
          <div class="community-stat-card">
            <div class="community-stat-num"><%= stats.underReview %></div>
            <div class="community-stat-label">Under Authority Review</div>
          </div>
          <div class="community-stat-card">
            <div class="community-stat-num"><%= stats.verified %></div>
            <div class="community-stat-label">Verified Problems</div>
          </div>
        </div>

        <!-- Problem Results -->
        <% if (problems && problems.length > 0) { %>
          <div class="community-problems-grid">
            <% problems.forEach(function(prob) { 
              const thumbImg = (prob.images && prob.images.length > 0) ? prob.images[0] : null;
              const supporterCount = prob.supporters ? prob.supporters.length : 1;
            %>
              <article class="community-problem-card">
                <!-- Thumbnail with seamless fallback if file is missing -->
                <% if (thumbImg) { %>
                  <div class="community-card-thumb-container">
                    <img 
                      src="<%= thumbImg %>" 
                      alt="<%= prob.title %> evidence photo" 
                      class="community-card-thumb" 
                      loading="lazy" 
                      onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                    />
                    <div class="community-card-thumb-placeholder" style="display: none;">
                      <svg class="community-card-thumb-placeholder-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                        <circle cx="12" cy="13" r="4"></circle>
                      </svg>
                      <span class="community-card-thumb-placeholder-text">Photo unavailable</span>
                    </div>
                  </div>
                <% } else { %>
                  <div class="community-card-thumb-placeholder">
                    <svg class="community-card-thumb-placeholder-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                      <circle cx="12" cy="13" r="4"></circle>
                    </svg>
                    <span class="community-card-thumb-placeholder-text">No photo attached</span>
                  </div>
                <% } %>

                <div class="community-card-body">
                  <div class="community-card-badge-row">
                    <span class="badge badge-primary" style="font-size: 0.6875rem;"><%= prob.category %></span>
                    <span class="badge badge-neutral" style="font-size: 0.6875rem;"><%= prob.status.replace('_', ' ') %></span>
                  </div>
                  <h3 class="community-card-title">
                    <a href="/problems/<%= prob._id %>" style="color: inherit; text-decoration: none;">
                      <%= prob.title %>
                    </a>
                  </h3>
                  <p class="community-card-desc"><%= prob.description %></p>
                  <div class="community-card-footer" style="display: flex; align-items: center; justify-content: space-between; padding-top: var(--space-3); border-top: 1px solid var(--color-surface-soft);">
                    <a href="/problems/<%= prob._id %>" class="btn btn-outline btn-sm">View Problem</a>
                    <a href="/auth/login?redirect=/problems/<%= prob._id %>" class="btn btn-sm btn-outline">👍 Support</a>
                  </div>
                </div>
              </article>
            <% }); %>
          </div>
        <% } %>

      </div>
    </main>
  <% } %>

  <!-- Footer -->
  <%- include('../partials/footer') %>

  <script src="/js/problems.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
