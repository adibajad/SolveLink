<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= problem.title %> — SolveLink Civic Report</title>
  
  <link rel="stylesheet" href="/css/global.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/problem.css">
  <link rel="stylesheet" href="/css/responsive.css">
</head>
<body>
  <% 
    const currentUserId = (typeof user !== 'undefined' && user) ? (user._id || user.id || '').toString() : '';
    const reporterId = problem && problem.reportedBy ? (problem.reportedBy._id || problem.reportedBy).toString() : '';
    const isOwner = Boolean(currentUserId && reporterId && currentUserId === reporterId);
  %>

  <!-- Navigation -->
  <%- include('../partials/navbar', { activePath: '/problems' }) %>

  <% if (typeof user !== 'undefined' && user) { %>
    <div class="dashboard-layout">
      <!-- Dynamic Reusable Sidebar -->
      <%- include('../partials/sidebar', { role: user.role || 'citizen', activePath: '/problems' }) %>

      <!-- Main Dashboard Content Area -->
      <main id="main-content" class="dashboard-main">
        <div class="dashboard-content">
          
          <!-- Back Button & Breadcrumbs -->
          <div style="margin-bottom: var(--space-6);">
            <nav class="detail-breadcrumb" aria-label="Breadcrumb">
              <a href="/citizen/dashboard">Dashboard</a>
              <span>&bull;</span>
              <a href="/problems">Community Problems</a>
              <span>&bull;</span>
              <span aria-current="page"><%= problem.category %></span>
            </nav>
          </div>

          <!-- Problem Detail Grid -->
          <div class="problem-detail-grid">
        
        <!-- Left: Main Problem Information & Evidence -->
        <div class="problem-main-content">

          <!-- 1. Header Card -->
          <div class="problem-section">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--space-3); flex-wrap: wrap; gap: var(--space-2);">
              <span class="badge badge-primary"><%= problem.category %></span>
              
              <div style="display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap;">
                <% 
                  let badgeClass = 'badge-neutral';
                  if (problem.status === 'VERIFIED') badgeClass = 'badge-success';
                  else if (problem.status === 'CHALLENGE_CREATED') badgeClass = 'badge-primary';
                  else if (problem.status === 'UNDER_VERIFICATION') badgeClass = 'badge-warning';
                  else if (problem.status === 'REJECTED') badgeClass = 'badge-danger';
                %>
                <span class="badge <%= badgeClass %>">
                  Status: <%= problem.status.replace('_', ' ') %>
                </span>

                <% if (isOwner) { %>
                  <button 
                    type="button" 
                    id="btnOpenDeleteModal" 
                    class="btn btn-outline btn-sm" 
                    data-problem-id="<%= problem._id %>"
                    style="color: var(--color-danger); border-color: rgba(166, 69, 69, 0.35); font-size: var(--font-size-xs); padding: 0.25rem 0.6rem; display: inline-flex; align-items: center; gap: 4px;" 
                    title="Delete this problem report"
                  >
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <polyline points="3 6 5 6 21 6"></polyline>
                      <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                    </svg>
                    Delete Report
                  </button>
                <% } %>
              </div>
            </div>

            <h1 style="font-size: var(--font-size-2xl); font-weight: var(--font-weight-bold); color: var(--color-text); line-height: 1.2; margin-bottom: var(--space-3);">
              <%= problem.title %>
            </h1>

            <div style="display: flex; align-items: center; gap: var(--space-4); font-size: var(--font-size-xs); color: var(--color-text-muted); flex-wrap: wrap;">
              <span style="display: inline-flex; align-items: center; gap: var(--space-1);">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
                <%= problem.location %>
                <% if (problem.latitude && problem.longitude) { %>
                  <span style="font-family: var(--font-mono); font-size: 0.6875rem; background: var(--color-bg); padding: 1px 5px; border-radius: var(--radius-sm); border: 1px solid var(--color-border); margin-left: 4px;">
                    <%= Number(problem.latitude).toFixed(4) %>, <%= Number(problem.longitude).toFixed(4) %>
                  </span>
                <% } %>
              </span>

              <span>&bull;</span>

              <span>
                Reported by <strong><%= problem.reportedBy ? problem.reportedBy.name : 'Citizen' %></strong>
              </span>

              <span>&bull;</span>

              <span><%= new Date(problem.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></span>
            </div>
          </div>

          <!-- 2. Problem Description -->
          <div class="problem-section">
            <h2 style="font-size: var(--font-size-md); font-weight: var(--font-weight-bold); margin-bottom: var(--space-3);">
              Problem Description
            </h2>
            <div class="detail-text">
              <p style="white-space: pre-line;"><%= problem.description %></p>
            </div>

            <!-- Evidence Images Gallery -->
            <% if (problem.images && problem.images.length > 0) { %>
              <h3 style="font-size: var(--font-size-sm); font-weight: var(--font-weight-semibold); margin-top: var(--space-6); margin-bottom: var(--space-2);">
                Photo Evidence (<%= problem.images.length %>)
              </h3>
              <div class="evidence-gallery">
                <% problem.images.forEach(function(imgUrl) { %>
                  <div class="evidence-thumb">
                    <img src="<%= imgUrl %>" alt="Evidence photo" loading="lazy" onerror="this.parentElement.style.display='none';" />
                  </div>
                <% }); %>
              </div>
            <% } else { %>
              <div style="margin-top: var(--space-6); padding: var(--space-4); background-color: var(--color-surface-soft); border-radius: var(--radius-md); border: 1px solid var(--color-border); display: flex; align-items: center; gap: var(--space-2); font-size: var(--font-size-xs); color: var(--color-text-muted);">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                  <circle cx="12" cy="13" r="4"></circle>
                </svg>
                <span>No additional photo attachments were uploaded with this submission.</span>
              </div>
            <% } %>
          </div>

          <!-- 3. AI-Assisted Analysis Card -->
          <div class="ai-analysis-card">
            <div class="ai-analysis-header">
              <div style="display: flex; align-items: center; gap: var(--space-2);">
                <span class="ai-badge">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                  </svg>
                  SolveLink AI Analysis
                </span>
                <span class="text-muted" style="font-size: var(--font-size-xs);">Automated Triage Assist</span>
              </div>
              <span class="text-muted" style="font-size: var(--font-size-xs);">Confidence: 92%</span>
            </div>

            <!-- AI Triaged Metrics -->
            <div class="ai-metrics-grid">
              <div class="ai-metric-pill">
                <div class="ai-metric-title">Detected Category</div>
                <div class="ai-metric-val" style="color: var(--color-primary);"><%= problem.category %></div>
              </div>

              <div class="ai-metric-pill">
                <div class="ai-metric-title">Estimated Severity</div>
                <div class="ai-metric-val" style="color: <%= problem.severity === 'CRITICAL' ? 'var(--color-danger)' : 'var(--color-text)' %>;">
                  <%= problem.severity || 'MEDIUM' %>
                </div>
              </div>

              <div class="ai-metric-pill">
                <div class="ai-metric-title">Priority Recommendation</div>
                <div class="ai-metric-val"><%= problem.priority || 'MEDIUM' %></div>
              </div>
            </div>

            <!-- AI Summary Statement -->
            <% if (problem.aiAnalysis && problem.aiAnalysis.summary) { %>
              <div style="background-color: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--space-4); margin-bottom: var(--space-4);">
                <span style="font-size: var(--font-size-xs); font-weight: var(--font-weight-bold); text-transform: uppercase; color: var(--color-text-muted); display: block; margin-bottom: 4px;">
                  AI Executive Summary
                </span>
                <p style="font-size: var(--font-size-sm); line-height: var(--line-height-relaxed); margin-bottom: 0; color: var(--color-text);">
                  <%= problem.aiAnalysis.summary %>
                </p>
              </div>
            <% } %>

            <!-- Tags -->
            <% if (problem.aiAnalysis && problem.aiAnalysis.tags && problem.aiAnalysis.tags.length > 0) { %>
              <div style="display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap;">
                <span style="font-size: var(--font-size-xs); color: var(--color-text-muted); font-weight: var(--font-weight-medium);">Extracted Keywords:</span>
                <% problem.aiAnalysis.tags.forEach(function(tag) { %>
                  <span class="badge badge-neutral" style="font-size: 0.6875rem;"><%= tag %></span>
                <% }); %>
              </div>
            <% } %>
          </div>

          <!-- 4. Possible Similar Problems / Duplicate Detection Section -->
          <div class="problem-section" style="border-left: 3px solid var(--color-warning);">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--space-3); flex-wrap: wrap; gap: var(--space-2);">
              <div>
                <h2 style="font-size: var(--font-size-md); font-weight: var(--font-weight-bold); margin-bottom: 2px; color: var(--color-text);">
                  Possible Similar Problems Nearby
                </h2>
                <p class="text-muted" style="font-size: var(--font-size-xs); margin-bottom: 0;">
                  SolveLink duplicate detection identified community reports in this area sharing similar infrastructure patterns:
                </p>
              </div>

              <% if (typeof user !== 'undefined' && user) { %>
                <button type="button" id="btnOpenDuplicateModal" class="btn btn-outline btn-sm" style="font-size: var(--font-size-xs); border-color: rgba(194, 139, 56, 0.4); color: var(--color-text);">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="8" y="2" width="13" height="13" rx="2" ry="2"></rect>
                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                  </svg>
                  <span>Report as Duplicate</span>
                </button>
              <% } %>
            </div>

            <% if (typeof scoredSimilarProblems !== 'undefined' && scoredSimilarProblems && scoredSimilarProblems.length > 0) { %>
              <div class="similar-problems-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: var(--space-3);">
                <% scoredSimilarProblems.forEach(function(sim) { 
                  const simProb = sim.problem;
                  const simSupporters = simProb.supporters ? simProb.supporters.length : 1;
                %>
                  <div class="similar-problem-card" style="background-color: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--space-3); display: flex; flex-direction: column; justify-content: space-between; transition: all var(--transition-fast);">
                    <div>
                      <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--space-2); gap: var(--space-2);">
                        <span class="badge badge-warning" style="font-size: 0.625rem;">Possible duplicate</span>
                        <span class="badge badge-primary" style="font-size: 0.625rem; font-weight: var(--font-weight-bold);">
                          AI similarity: <%= sim.percentage %>%
                        </span>
                      </div>

                      <h3 style="font-size: var(--font-size-sm); font-weight: var(--font-weight-semibold); margin-bottom: var(--space-1); line-height: 1.3;">
                        <a href="/problems/<%= simProb._id %>" style="color: var(--color-text); text-decoration: none;">
                          <%= simProb.title %>
                        </a>
                      </h3>

                      <div style="font-size: var(--font-size-xs); color: var(--color-text-muted); display: flex; align-items: center; gap: 4px; margin-bottom: var(--space-2);">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                          <circle cx="12" cy="10" r="3"></circle>
                        </svg>
                        <span><%= simProb.location %></span>
                      </div>
                    </div>

                    <div style="display: flex; align-items: center; justify-content: space-between; padding-top: var(--space-2); border-top: 1px solid var(--color-surface-soft); font-size: var(--font-size-xs);">
                      <span style="color: var(--color-text-muted);">👍 <%= simSupporters %> <%= simSupporters === 1 ? 'supporter' : 'supporters' %></span>
                      <a href="/problems/<%= simProb._id %>" class="btn btn-ghost btn-sm" style="padding: 2px 6px; font-size: var(--font-size-xs); color: var(--color-primary);">
                        View Problem &rarr;
                      </a>
                    </div>
                  </div>
                <% }); %>
              </div>
            <% } else if (problem.similarProblems && problem.similarProblems.length > 0) { %>
              <div class="dash-problem-list">
                <% problem.similarProblems.forEach(function(sim) { %>
                  <a href="/problems/<%= sim._id %>" class="dash-problem-card">
                    <div class="dash-problem-info">
                      <span class="dash-problem-title"><%= sim.title %></span>
                      <div class="dash-problem-meta">
                        <span><%= sim.category %></span>
                        <span>&bull;</span>
                        <span><%= sim.location %></span>
                      </div>
                    </div>
                    <span class="badge badge-neutral">View &rarr;</span>
                  </a>
                <% }); %>
              </div>
            <% } else { %>
              <p style="font-size: var(--font-size-xs); color: var(--color-text-muted); margin-bottom: 0;">
                No duplicate reports detected for this specific location. This appears to be a unique community issue.
              </p>
            <% } %>
          </div>

          <!-- 5. Associated Innovation Challenge (if verified and challenge created) -->
          <% if (associatedChallenge) { %>
            <div class="problem-section" style="border-left: 3px solid var(--color-success); background-color: var(--color-success-subtle);">
              <span class="badge badge-success" style="margin-bottom: var(--space-2);">Official Innovation Challenge Active</span>
              <h2 style="font-size: var(--font-size-lg); font-weight: var(--font-weight-bold); margin-bottom: var(--space-2);">
                <%= associatedChallenge.title %>
              </h2>
              <p style="font-size: var(--font-size-sm); color: var(--color-text); margin-bottom: var(--space-4);">
                This problem report was verified by authorities and elevated into an active challenge for university engineering and research teams.
              </p>
              <a href="/challenges/<%= associatedChallenge._id %>" class="btn btn-primary btn-sm">
                View Innovation Challenge Brief &rarr;
              </a>
            </div>
          <% } %>

          <!-- 6. Selected Solution & Pilot Implementation Status -->
          <% if (typeof selectedSolution !== 'undefined' && selectedSolution) { %>
            <div class="problem-section" style="border-left: 3px solid var(--color-primary); background-color: var(--color-surface);">
              <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--space-2); flex-wrap: wrap; gap: var(--space-2);">
                <span class="badge badge-primary">Selected Engineering Solution</span>
                <span class="badge badge-success">Pilot Implementation Phase</span>
              </div>
              <h2 style="font-size: var(--font-size-lg); font-weight: var(--font-weight-bold); margin-bottom: var(--space-2);">
                <%= selectedSolution.title %>
              </h2>
              <p style="font-size: var(--font-size-sm); color: var(--color-text-muted); margin-bottom: var(--space-3);">
                Developed by: <strong><%= selectedSolution.team?.name || selectedSolution.submittedBy?.name %></strong> (<%= selectedSolution.submittedBy?.organization || 'University Research Lab' %>)
              </p>
              <div style="background-color: var(--color-surface-soft); border-radius: var(--radius-md); padding: var(--space-3); margin-bottom: var(--space-3);">
                <span style="font-size: var(--font-size-xs); font-weight: var(--font-weight-bold); text-transform: uppercase; color: var(--color-text-muted); display: block; margin-bottom: 2px;">
                  Implementation Progression:
                </span>
                <div style="display: flex; align-items: center; gap: var(--space-2); font-size: var(--font-size-sm); font-weight: var(--font-weight-semibold); color: var(--color-primary);">
                  <span>Prototype Verified</span>
                  <span>&rarr;</span>
                  <span style="color: var(--color-success);">Field Pilot Active</span>
                  <span>&rarr;</span>
                  <span style="color: var(--color-text-muted);">Full Deployment</span>
                </div>
              </div>
              <% if (selectedSolution.impact) { %>
                <p style="font-size: var(--font-size-sm); margin-bottom: 0;">
                  <strong>Verified Impact:</strong> <%= selectedSolution.impact %>
                </p>
              <% } %>
            </div>
          <% } %>

        </div>

        <!-- Right: Actions, Upvoting, & 8-Stage Lifecycle Visualization -->
        <aside style="display: flex; flex-direction: column; gap: var(--space-6);">
          
          <!-- Upvote / Community Support Action Card -->
          <div class="card card-body">
            <h2 style="font-size: var(--font-size-sm); font-weight: var(--font-weight-bold); text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-text-muted); margin-bottom: var(--space-3);">
              Community Support
            </h2>

            <div style="display: flex; align-items: baseline; gap: var(--space-2); margin-bottom: var(--space-4);">
              <span id="supporterCountText" style="font-size: var(--font-size-2xl); font-weight: var(--font-weight-bold); color: var(--color-primary);">
                <%= problem.supporters ? problem.supporters.length : 1 %> <%= (problem.supporters && problem.supporters.length === 1) ? 'Supporter' : 'Supporters' %>
              </span>
            </div>

            <button 
              id="btnSupportProblem" 
              class="btn-support <%= isSupporter ? 'supported' : '' %>" 
              data-problem-id="<%= problem._id %>"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"></path>
              </svg>
              <span class="support-btn-label"><%= isSupporter ? '✓ Supported' : '👍 Support This Problem' %></span>
            </button>
            <p class="text-muted text-center" style="font-size: var(--font-size-xs); line-height: 1.45; margin-top: var(--space-3); margin-bottom: 0;">
              Community support helps SolveLink identify problems affecting more people and can increase their priority for authority review.
            </p>

            <% if (problem.affectedPeople) { %>
              <div style="margin-top: var(--space-3); padding-top: var(--space-3); border-top: 1px solid var(--color-surface-soft); font-size: var(--font-size-xs); color: var(--color-text-muted);">
                <span style="font-weight: var(--font-weight-semibold); color: var(--color-text);">Impact Scale:</span>
                <span><%= problem.affectedPeople %> affected</span>
              </div>
            <% } %>

            <% if (problem.duplicateOf) { %>
              <div style="margin-top: var(--space-3); padding: var(--space-2) var(--space-3); border-radius: var(--radius-sm); background-color: rgba(194, 139, 56, 0.08); border: 1px solid rgba(194, 139, 56, 0.25); font-size: var(--font-size-xs); color: var(--color-text);">
                <strong>Linked Duplicate:</strong> This issue was linked as related to <a href="/problems/<%= problem.duplicateOf._id %>" style="color: var(--color-primary); font-weight: var(--font-weight-semibold);"><%= problem.duplicateOf.title %></a>.
              </div>
            <% } %>

            <% if (problem.duplicateReports && problem.duplicateReports.length > 0) { %>
              <div style="margin-top: var(--space-3); font-size: var(--font-size-xs); color: var(--color-text-muted); padding-top: var(--space-2); border-top: 1px solid var(--color-surface-soft);">
                <strong>Related Reports:</strong> <%= problem.duplicateReports.length %> community <%= problem.duplicateReports.length === 1 ? 'report has' : 'reports have' %> been linked to this issue.
              </div>
            <% } %>
          </div>

          <!-- 8-Stage Lifecycle Tracker -->
          <div class="card card-body">
            <h3 style="font-size: var(--font-size-sm); font-weight: var(--font-weight-bold); margin-bottom: var(--space-3);">
              Problem Lifecycle
            </h3>

            <%
              const st = problem.status;
              const hasSupporters = problem.supporters && problem.supporters.length > 1;
              const isUnderVer = st === 'UNDER_VERIFICATION';
              const isVer = st === 'VERIFIED';
              const isChal = st === 'CHALLENGE_CREATED' || !!associatedChallenge;
              const chalStatus = associatedChallenge ? associatedChallenge.status : null;
              const isSolutionSelected = chalStatus === 'SOLUTION_SELECTED' || chalStatus === 'IMPLEMENTATION' || chalStatus === 'COMPLETED' || !!selectedSolution;
              const isImplementation = chalStatus === 'IMPLEMENTATION' || chalStatus === 'COMPLETED';
              const isCompleted = chalStatus === 'COMPLETED';
            %>

            <div class="lifecycle-8-tracker">
              <!-- 1. Reported -->
              <div class="lifecycle-8-node completed">
                <span class="lifecycle-8-dot"></span>
                <span>1. Citizen Reported</span>
              </div>

              <!-- 2. Community Supported -->
              <div class="lifecycle-8-node <%= (hasSupporters || isUnderVer || isVer || isChal) ? 'completed' : 'active' %>">
                <span class="lifecycle-8-dot"></span>
                <span>2. Community Supported (<%= problem.supporters ? problem.supporters.length : 1 %>)</span>
              </div>

              <!-- 3. Under Verification -->
              <div class="lifecycle-8-node <%= (isVer || isChal) ? 'completed' : (isUnderVer ? 'active' : '') %>">
                <span class="lifecycle-8-dot"></span>
                <span>3. Authority Review & Verification</span>
              </div>

              <!-- 4. Verified -->
              <div class="lifecycle-8-node <%= isChal ? 'completed' : (isVer ? 'active' : '') %>">
                <span class="lifecycle-8-dot"></span>
                <span>4. Verified Ground Problem</span>
              </div>

              <!-- 5. Innovation Challenge -->
              <div class="lifecycle-8-node <%= isSolutionSelected ? 'completed' : (isChal ? 'active' : '') %>">
                <span class="lifecycle-8-dot"></span>
                <span>5. Innovation Challenge Published</span>
              </div>

              <!-- 6. Solution Submissions -->
              <div class="lifecycle-8-node <%= isImplementation ? 'completed' : (isSolutionSelected ? 'active' : (isChal ? 'active' : '')) %>">
                <span class="lifecycle-8-dot"></span>
                <span>6. University Solution Proposals</span>
              </div>

              <!-- 7. Implementation -->
              <div class="lifecycle-8-node <%= isCompleted ? 'completed' : (isImplementation ? 'active' : '') %>">
                <span class="lifecycle-8-dot"></span>
                <span>7. On-Ground Pilot Implementation</span>
              </div>

              <!-- 8. Completed -->
              <div class="lifecycle-8-node <%= isCompleted ? 'completed' : '' %>">
                <span class="lifecycle-8-dot"></span>
                <span>8. Civic Problem Resolved</span>
              </div>
            </div>
          </div>

          <!-- Authority Controls Panel (Visible ONLY to Authority / Admin users) -->
          <% if (typeof user !== 'undefined' && user && (user.role === 'authority' || user.role === 'admin')) { %>
            <div class="card card-body" style="border-left: 3px solid var(--color-primary); background-color: var(--color-surface);">
              <span class="badge badge-primary" style="margin-bottom: var(--space-2);">Authority Action Panel</span>
              <h3 style="font-size: var(--font-size-sm); font-weight: var(--font-weight-bold); margin-bottom: var(--space-2);">
                Administrative Triage
              </h3>
              <p class="text-muted" style="font-size: var(--font-size-xs); margin-bottom: var(--space-3);">
                As a verified authority officer, you can elevate this problem into an official challenge or update its verification status.
              </p>

              <div style="display: flex; flex-direction: column; gap: var(--space-2);">
                <a href="/authority/create-challenge?problemId=<%= problem._id %>" class="btn btn-primary btn-sm btn-block">
                  Convert to Innovation Challenge
                </a>
                <a href="/authority/problems" class="btn btn-outline btn-sm btn-block">
                  Manage in Authority Console
                </a>
              </div>
            </div>
          <% } %>

        </aside>

      </div>

    </div>
  </main>
</div>
<% } else { %>
  <!-- Public Layout if Guest -->
  <main id="main-content" class="main-content section">
    <div class="container">
      <div class="problem-detail-grid">
        <!-- Problem details rendered in public mode -->
      </div>
    </div>
  </main>
<% } %>

  <!-- Duplicate Linking Confirmation Modal -->
  <div id="linkDuplicateModal" class="ai-processing-modal" role="dialog" aria-modal="true" aria-labelledby="duplicateModalTitle" style="display: none; z-index: var(--z-modal);">
    <div class="ai-processing-card" style="max-width: 480px; text-align: left; padding: var(--space-6);">
      
      <div style="display: flex; align-items: center; gap: var(--space-3); margin-bottom: var(--space-3);">
        <div style="width: 40px; height: 40px; border-radius: var(--radius-full); background-color: rgba(194, 139, 56, 0.12); display: flex; align-items: center; justify-content: center; color: var(--color-accent); flex-shrink: 0;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="8" y="2" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
        </div>
        <div>
          <h3 id="duplicateModalTitle" style="font-size: var(--font-size-lg); font-weight: var(--font-weight-bold); margin-bottom: 0; color: var(--color-text);">
            Do you think this is the same issue?
          </h3>
        </div>
      </div>

      <p style="font-size: var(--font-size-sm); color: var(--color-text-muted); line-height: 1.5; margin-bottom: var(--space-4);">
        Linking duplicate reports helps authorities understand the true scale of a problem and prevents repeated reports.
      </p>

      <form id="linkDuplicateForm" data-current-problem-id="<%= problem._id %>">
        <div class="form-group" style="margin-bottom: var(--space-4);">
          <label for="targetDuplicateSelect" class="form-label" style="font-size: var(--font-size-xs);">
            Select Primary / Existing Problem:
          </label>
          <select id="targetDuplicateSelect" name="targetProblemId" class="form-select" required>
            <option value="">Choose matching problem...</option>
            <% if (typeof scoredSimilarProblems !== 'undefined' && scoredSimilarProblems && scoredSimilarProblems.length > 0) { %>
              <% scoredSimilarProblems.forEach(function(sp) { %>
                <option value="<%= sp.problem._id %>"><%= sp.problem.title %> (<%= sp.percentage %>% match &bull; <%= sp.problem.location %>)</option>
              <% }); %>
            <% } %>
          </select>
        </div>

        <div class="form-group" style="margin-bottom: var(--space-5);">
          <label for="duplicateNoteInput" class="form-label" style="font-size: var(--font-size-xs);">
            Why do you think these are the same? (Optional)
          </label>
          <input type="text" id="duplicateNoteInput" name="note" class="form-input" placeholder="e.g. Same pipeline rupture on Main Road" />
        </div>

        <div id="duplicateLinkError" class="field-error-text" style="display: none; margin-bottom: var(--space-4);"></div>

        <div style="display: flex; justify-content: flex-end; gap: var(--space-3);">
          <button type="button" id="btnCancelDuplicateModal" class="btn btn-outline">Cancel</button>
          <button type="submit" id="btnSubmitDuplicateLink" class="btn btn-primary">
            <span id="btnDuplicateLinkText">Yes, Link as Similar</span>
          </button>
        </div>
      </form>

    </div>
  </div>

  <% if (isOwner) { %>
    <!-- Delete Report Confirmation Modal Overlay -->
    <div id="deleteReportModal" class="ai-processing-modal" role="dialog" aria-modal="true" aria-labelledby="deleteModalTitle" style="display: none; z-index: var(--z-modal);">
      <div class="ai-processing-card" style="max-width: 440px; text-align: left; padding: var(--space-6);">
        
        <!-- Delete Confirmation -->
        <div id="deleteStepConfirm">
          <div style="display: flex; align-items: center; gap: var(--space-3); margin-bottom: var(--space-3);">
            <div style="width: 40px; height: 40px; border-radius: var(--radius-full); background-color: rgba(166, 69, 69, 0.12); display: flex; align-items: center; justify-content: center; color: var(--color-danger); flex-shrink: 0;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="3 6 5 6 21 6"></polyline>
                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                <line x1="10" y1="11" x2="10" y2="17"></line>
                <line x1="14" y1="11" x2="14" y2="17"></line>
              </svg>
            </div>
            <div>
              <h3 id="deleteModalTitle" style="font-size: var(--font-size-lg); font-weight: var(--font-weight-bold); margin-bottom: 0; color: var(--color-text);">
                Delete this report?
              </h3>
            </div>
          </div>

          <p style="font-size: var(--font-size-sm); color: var(--color-text-muted); line-height: 1.5; margin-bottom: var(--space-6);">
            This action will permanently remove your report and any uploaded media. This action cannot be undone.
          </p>

          <div id="deleteRequestError" class="field-error-text" style="display: none; margin-bottom: var(--space-4);"></div>

          <div style="display: flex; justify-content: flex-end; gap: var(--space-3);">
            <button type="button" id="btnCancelDeleteConfirm" class="btn btn-outline">Cancel</button>
            <button type="button" id="btnConfirmDeleteReport" class="btn btn-danger">
              <span id="btnConfirmDeleteText">Delete Report</span>
            </button>
          </div>
        </div>

      </div>
    </div>
  <% } %>

  <!-- Footer -->
  <%- include('../partials/footer') %>

  <script src="/js/problems.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
