<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Industry Partner Portal — SolveLink</title>
  
  <link rel="stylesheet" href="/css/global.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/challenges.css">
  <link rel="stylesheet" href="/css/problem.css">
  <link rel="stylesheet" href="/css/responsive.css">
</head>
<body>

  <!-- Navigation Bar -->
  <%- include('../partials/navbar', { activePath: '/industry/dashboard' }) %>

  <!-- Dashboard Layout -->
  <div class="dashboard-layout">
    
    <!-- Dynamic Reusable Sidebar -->
    <%- include('../partials/sidebar', { role: 'industry', activePath: '/industry/dashboard' }) %>

    <!-- Main Dashboard Work Area -->
    <main id="main-content" class="dashboard-main">
      <div class="dashboard-content">
        
        <!-- Topbar -->
        <div class="dashboard-topbar">
          <div class="dashboard-title-group">
            <h1 class="dashboard-welcome">Industry Partner Portal</h1>
            <p class="dashboard-sub"><%= user ? (user.organization || user.name) : 'Partner Enterprise' %> &bull; Pilot Implementation, Manufacturing Scale & Commercialization</p>
          </div>
          <div class="dashboard-actions">
            <a href="/industry/solutions" class="btn btn-secondary btn-md">
              Browse University Solutions
            </a>
            <a href="/industry/challenges" class="btn btn-primary btn-md">
              Discover Active Challenges
            </a>
          </div>
        </div>

        <% if (typeof collaboratedMsg !== 'undefined' && collaboratedMsg) { %>
          <div class="alert alert-success" style="margin-bottom: var(--space-6);">
            <span><%= collaboratedMsg %></span>
          </div>
        <% } %>

        <!-- Metrics Grid -->
        <div class="dash-stats-grid">
          <div class="dash-stat-card" style="border-left: 3px solid var(--color-primary);">
            <div>
              <div class="dash-stat-num" style="color: var(--color-primary);"><%= metrics.topSynergyScore %>%</div>
              <div class="dash-stat-label">Top Synergy Match</div>
            </div>
            <div class="dash-stat-icon" style="color: var(--color-primary);">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
              </svg>
            </div>
          </div>

          <div class="dash-stat-card">
            <div>
              <div class="dash-stat-num"><%= metrics.activeChallengesCount %></div>
              <div class="dash-stat-label">Active Challenges</div>
            </div>
            <div class="dash-stat-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="8" r="7"></circle>
                <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline>
              </svg>
            </div>
          </div>

          <div class="dash-stat-card" style="border-left: 3px solid var(--color-warning);">
            <div>
              <div class="dash-stat-num" style="color: var(--color-warning);"><%= metrics.matchedSolutionsCount %></div>
              <div class="dash-stat-label">High-Synergy Solutions</div>
            </div>
            <div class="dash-stat-icon" style="color: var(--color-warning);">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                <line x1="12" y1="22.08" x2="12" y2="12"></line>
              </svg>
            </div>
          </div>

          <div class="dash-stat-card" style="border-left: 3px solid var(--color-success);">
            <div>
              <div class="dash-stat-num" style="color: var(--color-success);"><%= metrics.collaborationsCount %></div>
              <div class="dash-stat-label">Active Partnerships</div>
            </div>
            <div class="dash-stat-icon" style="color: var(--color-success);">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
              </svg>
            </div>
          </div>
        </div>

        <!-- Dashboard Main Grid Split -->
        <div class="dash-grid-split">
          
          <!-- Column Left: Recommended University Solutions Ranked by Industry Synergy -->
          <div>
            <div class="dash-section-header">
              <h2 class="dash-section-title">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                </svg>
                University Solutions Matched to Your Capabilities
              </h2>
              <a href="/industry/solutions" class="btn btn-ghost btn-sm">Explore All &rarr;</a>
            </div>

            <% if (recommendedSolutions && recommendedSolutions.length > 0) { %>
              <div class="dash-problem-list">
                <% recommendedSolutions.forEach(function(s) { 
                  let matchBadgeClass = 'badge-neutral';
                  if (s.synergyScore >= 75) matchBadgeClass = 'badge-success';
                  else if (s.synergyScore >= 50) matchBadgeClass = 'badge-warning';
                %>
                  <a href="/industry/solutions/<%= s._id %>" class="dash-problem-card" style="padding: var(--space-4) var(--space-5);">
                    <div class="dash-problem-info">
                      <div style="display: flex; align-items: center; gap: var(--space-2); margin-bottom: 2px;">
                        <span class="badge badge-primary" style="font-size: 0.6875rem;"><%= s.challenge?.category || 'Civic Tech' %></span>
                        <span class="badge <%= matchBadgeClass %>" style="font-size: 0.6875rem;">
                          <%= s.synergyScore %>% Synergy Match
                        </span>
                        <span class="badge badge-neutral" style="font-size: 0.6875rem;"><%= s.status.replace('_', ' ') %></span>
                      </div>
                      <span class="dash-problem-title" style="font-size: var(--font-size-base);"><%= s.title %></span>
                      
                      <div class="dash-problem-meta" style="margin-top: 3px;">
                        <span>🎓 Lab: <%= s.submittedBy?.organization || s.submittedBy?.name || 'University Lab' %></span>
                        <span>&bull;</span>
                        <span>Challenge: <%= s.challenge?.title?.substring(0, 30) %>...</span>
                        <% if (s.matchedCapabilities && s.matchedCapabilities.length > 0) { %>
                          <span>&bull;</span>
                          <span style="color: var(--color-success);">Synergy: <%= s.matchedCapabilities.slice(0, 2).join(', ') %></span>
                        <% } %>
                      </div>
                    </div>
                    
                    <div class="dash-problem-side">
                      <span class="btn btn-primary btn-sm">Collaborate &rarr;</span>
                    </div>
                  </a>
                <% }); %>
              </div>
            <% } else { %>
              <div class="card card-body text-center" style="padding: var(--space-8);">
                <p class="text-muted" style="margin-bottom: 0;">No university solutions currently available for industry matching.</p>
              </div>
            <% } %>

            <!-- Active Innovation Challenges Open for Industry Implementation -->
            <div style="margin-top: var(--space-8);">
              <div class="dash-section-header">
                <h2 class="dash-section-title">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="8" r="7"></circle>
                    <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline>
                  </svg>
                  Government Innovation Briefs Seeking Industry Scale
                </h2>
                <a href="/industry/challenges" class="btn btn-ghost btn-sm">View All Challenges &rarr;</a>
              </div>

              <% if (recommendedChallenges && recommendedChallenges.length > 0) { %>
                <div class="dash-problem-list">
                  <% recommendedChallenges.forEach(function(c) { %>
                    <a href="/industry/challenges/<%= c._id %>" class="dash-problem-card">
                      <div class="dash-problem-info">
                        <span class="dash-problem-title"><%= c.title %></span>
                        <div class="dash-problem-meta">
                          <span>📍 <%= c.location || 'Jharkhand' %></span>
                          <span>&bull;</span>
                          <span>Dept: <%= c.department %></span>
                          <span>&bull;</span>
                          <span>Domain: <%= c.category %></span>
                        </div>
                      </div>
                      <span class="btn btn-outline btn-sm">View Brief &rarr;</span>
                    </a>
                  <% }); %>
                </div>
              <% } %>
            </div>

          </div>

          <!-- Column Right: Enterprise Profile & My Active Collaborations -->
          <div style="display: flex; flex-direction: column; gap: var(--space-6);">
            
            <!-- Industry Profile & Capabilities Card -->
            <div class="card card-body">
              <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--space-3);">
                <h3 style="font-size: var(--font-size-sm); font-weight: var(--font-weight-bold); text-transform: uppercase; color: var(--color-text-muted); margin-bottom: 0;">
                  Enterprise Profile
                </h3>
                <span class="badge badge-primary" style="font-size: 0.6875rem;">Industry Partner</span>
              </div>

              <div style="margin-bottom: var(--space-3);">
                <strong><%= user.name %></strong>
                <div class="text-muted" style="font-size: var(--font-size-xs);"><%= user.organization || 'Industrial Technology Partner' %></div>
                <div class="text-muted" style="font-size: var(--font-size-xs);">📍 <%= user.location || 'Jharkhand, India' %></div>
              </div>

              <div style="font-size: var(--font-size-xs); font-weight: var(--font-weight-semibold); color: var(--color-text-muted); margin-bottom: var(--space-2); text-transform: uppercase;">
                Registered Capabilities:
              </div>

              <div style="display: flex; flex-wrap: wrap; gap: var(--space-2); margin-bottom: var(--space-4);">
                <% if (user.skills && user.skills.length > 0) { %>
                  <% user.skills.forEach(function(s) { %>
                    <span class="badge badge-primary" style="font-size: 0.6875rem;"><%= s %></span>
                  <% }); %>
                <% } else { %>
                  <span class="badge badge-neutral">Field Manufacturing</span>
                  <span class="badge badge-neutral">Hardware Deployment</span>
                  <span class="badge badge-neutral">Commercial Scaling</span>
                <% } %>
              </div>

              <p class="text-muted" style="font-size: var(--font-size-xs); margin-bottom: 0;">
                SolveLink matches your commercial capabilities with university research prototypes to accelerate pilot deployments.
              </p>
            </div>

            <!-- My Active Collaboration Requests -->
            <div>
              <div class="dash-section-header">
                <h2 class="dash-section-title">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                  </svg>
                  My Collaborations
                </h2>
              </div>

              <% if (myCollaborations && myCollaborations.length > 0) { %>
                <div class="dash-problem-list">
                  <% myCollaborations.forEach(function(collab) { 
                    let statusBadge = 'badge-warning';
                    if (collab.status === 'ACCEPTED' || collab.status === 'IN_PARTNERSHIP') statusBadge = 'badge-success';
                    else if (collab.status === 'DECLINED') statusBadge = 'badge-danger';
                  %>
                    <div class="dash-problem-card">
                      <div class="dash-problem-info">
                        <span class="dash-problem-title"><%= collab.proposal ? collab.proposal.title : 'Solution Collaboration' %></span>
                        <div class="dash-problem-meta">
                          <span>Challenge: <%= collab.challenge ? collab.challenge.title?.substring(0, 25) : 'Challenge' %>...</span>
                          <span>&bull;</span>
                          <span>Type: <%= (collab.supportType || 'Pilot').replace('_', ' ') %></span>
                        </div>
                      </div>
                      <span class="badge <%= statusBadge %>"><%= collab.status %></span>
                    </div>
                  <% }); %>
                </div>
              <% } else { %>
                <div class="card card-body text-center" style="padding: var(--space-6);">
                  <p class="text-muted" style="font-size: var(--font-size-sm); margin-bottom: var(--space-3);">No active partnership requests yet.</p>
                  <a href="/industry/solutions" class="btn btn-primary btn-sm">Find Solutions to Partner With</a>
                </div>
              <% } %>
            </div>

          </div>

        </div>

      </div>
    </main>

  </div>

  <!-- Footer -->
  <%- include('../partials/footer') %>

  <script src="/js/dashboard.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
